#version 450

// Bounded screen-space tile lists with WORLD-space decal volumes and liquid.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depth_image;
layout(set = 0, binding = 1) uniform sampler2D normal_image;
layout(rgba16f, set = 0, binding = 2) writeonly uniform image2D blood_output;

struct Decal
{
    mat4 inverse_world;
    vec4 normal_kind;
    vec4 properties; // wetness, variation, RECEIVER instance ID, unused
};
layout(std430, set = 0, binding = 3) readonly buffer Decals
{
    Decal decals[];
};
layout(std430, set = 0, binding = 4) readonly buffer DecalTileCount
{
    uint decal_count[];
};
layout(std430, set = 0, binding = 5) readonly buffer DecalTileIndex
{
    uint decal_indices[];
};

struct Drop
{
    vec4 start;      // xyz world position, w radius (m)
    vec4 end;        // xyz world position, w radius (m)
    vec4 properties; // wetness, variation, unused, unused
};
layout(std430, set = 0, binding = 6) readonly buffer Drops
{
    Drop drops[];
};
layout(std430, set = 0, binding = 7) readonly buffer DropTileCount
{
    uint drop_count[];
};
layout(std430, set = 0, binding = 8) readonly buffer DropTileIndex
{
    uint drop_indices[];
};

// Nearest-filtered R32_UINT attachment from the geometry pass.
// Decals NEVER spill onto a different mesh or through a nearby character.
layout(set = 0, binding = 9) uniform usampler2D receiver_image;

layout(push_constant) uniform Settings
{
    mat4 inverse_view_projection;
    uint width;
    uint height;
    uint decals;
    uint flags; // bit 0 reverse depth, bit 1 encoded normals
} pc;

const uint TILE_SIZE = 16u;
const uint DECAL_TILE_CAP = 48u;
const uint DROP_TILE_CAP = 32u;
const float infinity = 1e20;

float hash(vec2 p)
{
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

vec3 world_from_depth(vec2 ndc, float depth)
{
    vec4 homogeneous = pc.inverse_view_projection * vec4(ndc, depth, 1.0);
    return homogeneous.xyz / max(abs(homogeneous.w), 1e-8) *
           (homogeneous.w < 0.0 ? -1.0 : 1.0);
}

float stain_mask(vec2 p, float seed, bool pool)
{
    p *= 2.0;
    float theta = atan(p.y, p.x);
    float r = length(p);
    float lobes = .075 * sin(theta * 7.0 + seed) +
                  .050 * sin(theta * 13.0 - seed * 2.3) +
                  .025 * cos(theta * 23.0 + seed * 4.1);
    float edge = (pool ? .82 : .63) + lobes;
    float body = 1.0 - smoothstep(edge - .09, edge + .012, r);

    if (pool) return body;

    // Sparse radial ligaments and uneven satellite deposits, generated
    // in stable decal-local coordinates rather than from screen pixels.
    float strand = pow(max(cos(theta * 8.0 + seed), 0.0), 28.0);
    strand *= (1.0 - smoothstep(.93, 1.25, r));
    strand *= smoothstep(.54, .64, r);
    vec2 cell = floor(p * 9.0 + seed);
    vec2 c = (cell + vec2(hash(cell), hash(cell + 91.7))) / 9.0;
    float satellite = (1.0 - smoothstep(.025, .048, length(p - c))) *
                      step(.93, hash(cell + seed));
    return clamp(max(body, max(strand * .65, satellite * .6)), 0.0, 1.0);
}

vec3 blood_color(float wet, float thickness)
{
    vec3 dried = vec3(.041, .008, .006);
    vec3 fresh = vec3(.128, .006, .012);
    return mix(dried, fresh, clamp(wet, 0.0, 1.0)) *
           mix(.72, 1.04, clamp(thickness, 0.0, 1.0));
}

void composite(inout vec4 value, vec3 pigment, float coverage)
{
    float a = clamp(coverage, 0.0, 1.0);
    float total = a + value.a * (1.0 - a);
    if (total < 1e-6) return;
    value.rgb = (pigment * a + value.rgb * value.a * (1.0 - a)) / total;
    value.a = total;
}

float sphere_hit(vec3 ro, vec3 rd, vec3 center, float radius)
{
    vec3 oc = ro - center;
    float b = dot(oc, rd);
    float h = b * b - dot(oc, oc) + radius * radius;
    if (h < 0.0) return infinity;
    float root = sqrt(h);
    float t = -b - root;
    return t > 0.0 ? t : (-b + root > 0.0 ? -b + root : infinity);
}

// Ray versus a world-space capsule, including both rounded ends.
// The ray-depth result is independent of camera rotation and screen-space
// endpoint depth approximation.
float capsule_hit(vec3 ro, vec3 rd, vec3 a, vec3 b,
                  float radius, out vec3 normal)
{
    vec3 ab = b - a;
    float abab = dot(ab, ab);
    float t = min(sphere_hit(ro, rd, a, radius),
                  sphere_hit(ro, rd, b, radius));

    if (abab > 1e-8)
    {
        vec3 ao = ro - a;
        float abrd = dot(ab, rd);
        float abao = dot(ab, ao);
        float rd_ao = dot(rd, ao);
        float A = abab - abrd * abrd;
        float B = abab * rd_ao - abao * abrd;
        float C = abab * (dot(ao, ao) - radius * radius) -
                  abao * abao;
        float discriminant = B * B - A * C;

        if (A > 1e-7 && discriminant >= 0.0)
        {
            float side_t = (-B - sqrt(discriminant)) / A;
            float side_position = abao + side_t * abrd;
            if (side_t > 0.0 && side_position > 0.0 &&
                side_position < abab)
                t = min(t, side_t);
        }
    }

    if (t >= infinity) return infinity;
    vec3 hit = ro + rd * t;
    vec3 nearest = abab > 1e-8 ?
        a + ab * clamp(dot(hit - a, ab) / abab, 0.0, 1.0) : a;
    normal = normalize(hit - nearest);
    return t;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.width) || pixel.y >= int(pc.height)) return;

    uint columns = (pc.width + TILE_SIZE - 1u) / TILE_SIZE;
    uint tile = (uint(pixel.y) / TILE_SIZE) * columns +
                (uint(pixel.x) / TILE_SIZE);
    vec2 uv = (vec2(pixel) + .5) / vec2(pc.width, pc.height);
    vec2 ndc = uv * 2.0 - 1.0;
    float depth = texelFetch(depth_image, pixel, 0).r;
    bool background = (pc.flags & 1u) != 0u ?
        depth <= .000001 : depth >= .999999;

    vec4 result = vec4(0.0);
    vec3 surface = vec3(0.0);
    float surface_distance = infinity;

    // Both the surface and the fluid use the SAME inverse projection.
    vec3 near_point = world_from_depth(ndc, 0.0);
    vec3 far_point = world_from_depth(ndc, 1.0);
    vec3 ray = normalize(far_point - near_point);
    if (!background)
    {
        surface = world_from_depth(ndc, depth);
        surface_distance = dot(surface - near_point, ray);
        uint receiver = texelFetch(receiver_image, pixel, 0).r;
        vec3 surface_normal = texelFetch(normal_image, pixel, 0).xyz;
        if ((pc.flags & 2u) != 0u)
            surface_normal = surface_normal * 2.0 - 1.0;
        surface_normal /= max(length(surface_normal), .0001);

        uint count = min(decal_count[tile], DECAL_TILE_CAP);
        for (uint j = 0; j < count; ++j)
        {
            uint id = decal_indices[tile * DECAL_TILE_CAP + j];
            if (id >= pc.decals) continue;
            Decal mark = decals[id];
            uint owner = uint(mark.properties.z + .5);
            if (owner == 0u || receiver != owner) continue;
            vec3 local = (mark.inverse_world * vec4(surface, 1.0)).xyz;
            if (any(greaterThan(abs(local), vec3(.5)))) continue;
            if (dot(surface_normal, normalize(mark.normal_kind.xyz)) < .65)
                continue;

            float mask = stain_mask(local.xy, mark.properties.y,
                                    mark.normal_kind.w >= 8.0);
            if (mask < .01) continue;
            float breakup = mix(.92, 1.0,
                hash(floor(surface.xz * 300.0) + float(id)));
            composite(result, blood_color(mark.properties.x, mask),
                      mask * breakup * .94);
        }
    }

    uint count = min(drop_count[tile], DROP_TILE_CAP);
    for (uint j = 0; j < count; ++j)
    {
        uint id = drop_indices[tile * DROP_TILE_CAP + j];
        Drop d = drops[id];
        vec3 normal;
        float radius = max(.001, max(d.start.w, d.end.w));
        float t = capsule_hit(near_point, ray, d.start.xyz, d.end.xyz,
                              radius, normal);
        if (t >= infinity || t > surface_distance - .003) continue;

        float wet = clamp(d.properties.x, 0.0, 1.0);
        float facing = clamp(dot(normal, -ray), 0.0, 1.0);
        vec3 half_vector = normalize(normalize(vec3(.4, .9, .25)) - ray);
        float glint = pow(max(0.0, dot(normal, half_vector)), 80.0);
        float edge = pow(1.0 - facing, 4.0);
        vec3 pigment = blood_color(wet, .95) *
                       (0.68 + .32 * facing) +
                       vec3(.30, .085, .075) * wet * glint * .50 +
                       vec3(.045, .018, .018) * wet * edge;
        composite(result, pigment, .98);
    }

    imageStore(blood_output, pixel, result);
}
