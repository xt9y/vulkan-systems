#version 450
// Screen-space liquid and surface stain compositor, Vulkan RGBA16F output.
// Host supplies depth, world normals, and projection matrices.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D depth_image;
layout(set = 0, binding = 1) uniform sampler2D normal_image;
layout(rgba16f, set = 0, binding = 2) writeonly uniform image2D blood_output;

struct Decal
{
    mat4 inverse_world;
    vec4 normal_kind;  // world normal, kind (8+ means pool)
    vec4 properties;   // wetness, variant_seed, reserved, reserved
};
layout(std430, set = 0, binding = 3) readonly buffer Decals
{
    Decal decals[];
};
layout(std430, set = 0, binding = 4) readonly buffer DecalTileCount
{
    uint decal_count[];
};
layout(std430, set = 0, binding = 5) readonly buffer DecalTileIndex
{
    uint decal_indices[];
};

struct Drop
{
    vec4 endpoints;   // start pixel xy, end pixel xy
    vec4 properties;  // radius pixels, ndc depth, lifetime factor, seed
};
layout(std430, set = 0, binding = 6) readonly buffer Drops
{
    Drop drops[];
};
layout(std430, set = 0, binding = 7) readonly buffer DropTileCount
{
    uint drop_count[];
};
layout(std430, set = 0, binding = 8) readonly buffer DropTileIndex
{
    uint drop_indices[];
};

layout(push_constant) uniform Settings
{
    mat4 inverse_view_projection;
    uint width;
    uint height;
    uint decals;
    uint flags; // 1: reversed depth, 2: encoded world normals
} pc;

const uint TILE_SIZE = 16u;
const uint DECAL_TILE_CAP = 48u;
const uint DROP_TILE_CAP = 32u;

float hash(vec2 p)
{
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

float splatter(vec2 q, float seed, bool pool)
{
    vec2 p = q * 2.0;
    float angle = atan(p.y, p.x);
    float radius = length(p);
    float edge = pool
        ? .83 + .085 * sin(angle * 5.0 + seed) +
                .04 * cos(angle * 13.0 - seed)
        : .68 + .13 * sin(angle * 7.0 + seed) +
                .085 * sin(angle * 11.0 - seed * 3.0) +
                .055 * cos(angle * 19.0 + seed);
    float body = 1.0 - smoothstep(edge - .075, edge + .02, radius);

    // Thin connected veins and satellite droplets, without animated particle spam.
    float strand = pow(max(0.0, cos(angle * 6.0 + seed)), 22.0);
    float reach = (1.18 + .38 * hash(vec2(floor(angle * 3.0), seed)));
    float rays = strand * (1.0 - smoothstep(reach - .14, reach, radius)) *
                 smoothstep(.49, .64, radius);
    vec2 cells = floor(p * 11.0 + seed);
    vec2 center = (cells + vec2(hash(cells), hash(cells + 19.7))) / 11.0;
    float satellite = (1.0 - smoothstep(.025, .055, length(p - center))) *
                      step(.89, hash(cells + seed));
    return clamp(max(body, max(rays * .8, satellite * .55)), 0.0, 1.0);
}

vec3 blood_pigment(float wetness, float thickness)
{
    vec3 dry = vec3(.045, .007, .005);
    vec3 fresh = vec3(.17, .005, .009);
    return mix(dry, fresh, clamp(wetness, 0.0, 1.0)) *
           mix(.78, 1.05, clamp(thickness, 0.0, 1.0));
}

void overlay(inout vec4 total, vec3 pigment, float alpha)
{
    alpha = clamp(alpha, 0.0, 1.0);
    float coverage = alpha + total.a * (1.0 - alpha);
    total.rgb = coverage > .00001
        ? (pigment * alpha + total.rgb * total.a * (1.0 - alpha)) / coverage
        : vec3(0.0);
    total.a = coverage;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(pc.width) || pixel.y >= int(pc.height)) return;

    uint columns = (pc.width + TILE_SIZE - 1u) / TILE_SIZE;
    uint tile = (uint(pixel.y) / TILE_SIZE) * columns +
                (uint(pixel.x) / TILE_SIZE);
    vec4 result = vec4(0.0);
    float depth = texelFetch(depth_image, pixel, 0).r;
    bool background = (pc.flags & 1u) != 0u ? depth <= .000001 :
                                                 depth >= .999999;
    if (!background)
    {
        vec2 uv = (vec2(pixel) + .5) / vec2(pc.width, pc.height);
        vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
        vec4 homogeneous = pc.inverse_view_projection * clip;
        if (abs(homogeneous.w) > .0000001)
        {
            vec3 world = homogeneous.xyz / homogeneous.w;
            vec3 normal = texelFetch(normal_image, pixel, 0).xyz;
            if ((pc.flags & 2u) != 0u) normal = normal * 2.0 - 1.0;
            normal /= max(length(normal), .0001);

            uint count = min(decal_count[tile], DECAL_TILE_CAP);
            for (uint i = 0; i < count; ++i)
            {
                uint id = decal_indices[tile * DECAL_TILE_CAP + i];
                if (id >= pc.decals) continue;
                Decal mark = decals[id];
                vec3 local = (mark.inverse_world * vec4(world, 1.0)).xyz;
                if (any(greaterThan(abs(local), vec3(.5, .5, .5))))
                    continue;
                if (dot(normal, normalize(mark.normal_kind.xyz)) < .22)
                    continue;
                bool pool = mark.normal_kind.w >= 8.0;
                float shape = splatter(local.xy, mark.properties.y, pool);
                float surface_breakup = .88 + .12 *
                    hash(floor(world.xz * 500.0) + float(id));
                float alpha = shape * surface_breakup * .96;
                if (alpha <= .001) continue;
                float thickness = mix(.55, 1.0, shape);
                overlay(result, blood_pigment(mark.properties.x, thickness), alpha);
            }
        }
    }

    uint count = min(drop_count[tile], DROP_TILE_CAP);
    for (uint i = 0; i < count; ++i)
    {
        uint id = drop_indices[tile * DROP_TILE_CAP + i];
        Drop d = drops[id];
        if (!background)
        {
            // Depth test the spray against scene geometry.
            float diff = d.properties.y - depth;
            if ((pc.flags & 1u) == 0u ? diff > .002 : diff < -.002)
                continue;
        }
        vec2 a = d.endpoints.xy;
        vec2 b = d.endpoints.zw;
        vec2 delta = b - a;
        float along = clamp(dot(vec2(pixel) + .5 - a, delta) /
                            max(dot(delta, delta), .00001), 0.0, 1.0);
        vec2 closest = mix(a, b, along);
        float distance = length(vec2(pixel) + .5 - closest);
        float radius = max(1.2, d.properties.x);
        float shape = 1.0 - smoothstep(radius * .6, radius + 1.1, distance);
        float end_fade = smoothstep(0.0, .17, along) *
                         (1.0 - smoothstep(.83, 1.0, along));
        overlay(result, blood_pigment(d.properties.z, 1.0),
                shape * mix(.55, .98, end_fade));
    }
    imageStore(blood_output, pixel, result);
}
