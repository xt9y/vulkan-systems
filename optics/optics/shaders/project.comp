#version 450
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
struct Photon {vec4 position;vec4 power;uvec4 link;};
layout(std430,set=0,binding=0) readonly buffer Photons {Photon photons[];};
layout(std430,set=0,binding=1) readonly buffer Count {uint used;};
layout(std430,set=0,binding=2) buffer Output {uint rgba[];};
layout(set=0,binding=3) uniform sampler2D depth_image;
layout(push_constant) uniform Params {
    mat4 view_projection;
    uvec4 size_and_capacity;
} pc;
void main()
{
    uint index=gl_GlobalInvocationID.x;
    if(index>=min(used,pc.size_and_capacity.z))return;
    Photon photon=photons[index];
    if(photon.link.z==0u || photon.position.w<.5) return;
    vec4 projection=pc.view_projection*vec4(photon.position.xyz,1.0);
    if(projection.w<=0.0001)return;
    vec3 ndc=projection.xyz/projection.w;
    vec2 uv=ndc.xy*.5+.5;
    if(any(lessThan(uv,vec2(0))) || any(greaterThanEqual(uv,vec2(1))) ||
       ndc.z<=0. || ndc.z>=1.)return;
    ivec2 size=ivec2(pc.size_and_capacity.xy);
    vec2 px=uv*vec2(size);
    ivec2 base=ivec2(px);
    // Depth validation prevents caustics painting through opaque geometry.
    float visible=texelFetch(depth_image,clamp(base,ivec2(0),size-1),0).r;
    if(abs(visible-ndc.z)>max(.0008,ndc.z*.0015))return;
    for(int y=-2;y<=2;++y)
    for(int x=-2;x<=2;++x) {
        ivec2 p=base+ivec2(x,y);
        if(any(lessThan(p,ivec2(0))) || any(greaterThanEqual(p,size)))continue;
        float w=exp(-float(x*x+y*y)*.4);
        vec3 contribution=clamp(photon.power.rgb*w*14000.,vec3(0),vec3(1000000));
        uint offset=uint(p.x+p.y*size.x)*3u;
        atomicAdd(rgba[offset+0u],uint(contribution.r));
        atomicAdd(rgba[offset+1u],uint(contribution.g));
        atomicAdd(rgba[offset+2u],uint(contribution.b));
    }
}
