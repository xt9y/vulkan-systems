#version 450
// One-time diffuse irradiance precomputation on the *same* Photon Mapping
// triangle BVH. Values are albedo-independent and shared by every reflected
// camera ray until the scene or lighting changes. Both sides of each face
// receive separate samples; emission and material texture remain per-hit.
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
const float PI=3.141592653589793;
struct Face {vec4 origin,u,v,normal,albedo,emission,metric;};
struct Node {vec3 minimum;uint next;vec3 maximum;uint first_and_count;};
struct Photon {vec4 position,power;uvec4 link;};
struct Light {vec4 position_radius,color_strength;};
layout(std430,set=0,binding=6) readonly buffer Faces {Face faces[];};
layout(std430,set=0,binding=7) readonly buffer Nodes {Node nodes[];};
layout(std430,set=0,binding=8) readonly buffer Triangles {vec4 triangles[];};
layout(std430,set=0,binding=9) readonly buffer Scene {
    uvec4 description;
    vec4 grid;
    uvec4 extra;
};
layout(std430,set=0,binding=10) readonly buffer Photons {Photon photons[];};
layout(std430,set=0,binding=11) readonly buffer Offsets {uint offsets[];};
layout(std430,set=0,binding=12) readonly buffer Lights {
    uvec4 light_count;
    Light lights[16];
};
struct FaceUV {vec4 uv01,uv2_origin,rect;};
layout(std430,set=0,binding=13) readonly buffer FaceCoordinates {
    FaceUV uv_faces[];
};
layout(set=0,binding=14) uniform sampler2D color_atlas;
layout(std430,set=0,binding=15) writeonly buffer Radiance {
    vec4 diffuse_light[];
};
layout(push_constant) uniform Params {uvec4 info;} pc;
bool overlap(vec3 ro,vec3 rd,vec3 lo,vec3 hi,float limit)
{
    vec3 safe=vec3(abs(rd.x)<1e-8?(rd.x<0.0?-1e-8:1e-8):rd.x,
                   abs(rd.y)<1e-8?(rd.y<0.0?-1e-8:1e-8):rd.y,
                   abs(rd.z)<1e-8?(rd.z<0.0?-1e-8:1e-8):rd.z);
    vec3 t0=(lo-ro)/safe,t1=(hi-ro)/safe;
    vec3 nearest=min(t0,t1),farthest=max(t0,t1);
    return max(max(nearest.x,nearest.y),max(nearest.z,.025))<=
           min(min(farthest.x,farthest.y),min(farthest.z,limit));
}
bool blocked(vec3 ro,vec3 direction,float limit,uint exclude)
{
    uint total=nodes[0].next;
    if(total==0u || total>1000000u)return false;
    uint index=0u;
    for(uint step=0u;index<total && step<total*2u;++step) {
        Node node=nodes[index];
        if(!overlap(ro,direction,node.minimum,node.maximum,limit)) {
            index=node.next;continue;
        }
        uint count=node.first_and_count&15u;
        if(count==0u){++index;continue;}
        uint first=node.first_and_count>>4u;
        for(uint k=0u;k<count;++k) {
            uint face_id=uint(triangles[(first+k)*3u].w);
            if(face_id>=description.x ||
               face_id==description.y || face_id==exclude)continue;
            Face f=faces[face_id];
            float denom=dot(direction,f.normal.xyz);
            if(abs(denom)<1e-6)continue;
            float distance=dot(f.origin.xyz-ro,f.normal.xyz)/denom;
            if(distance<=.025 || distance>=limit)continue;
            vec3 p=ro+direction*distance-f.origin.xyz;
            vec2 q=vec2(dot(p,f.u.xyz),dot(p,f.v.xyz));
            float u=q.x*f.metric.x+q.y*f.metric.y;
            float v=q.x*f.metric.y+q.y*f.metric.z;
            if(u<-.0001 || v<-.0001 || u>1.0001 || v>1.0001 ||
               (f.normal.w>.5 && u+v>1.0001))continue;
            // Preserve alpha-cutout visibility in cached point-light
            // shadows; holes in vegetation/hair must not become slabs.
            FaceUV mapping=uv_faces[face_id];
            if(mapping.rect.z>.5 && mapping.rect.w>.0) {
                vec2 uv=fract(mapping.uv01.xy*(1.0-u-v)+
                    mapping.uv01.zw*u+mapping.uv2_origin.xy*v);
                vec2 size=vec2(textureSize(color_atlas,0));
                vec2 lo=mapping.uv2_origin.zw+.5/size;
                vec2 hi=mapping.uv2_origin.zw+mapping.rect.xy-.5/size;
                if(textureLod(color_atlas,mix(lo,hi,uv),0.0).a<
                   mapping.rect.w)continue;
            }
            if(f.albedo.w<=.001)return true; // opaque and reflective block
        }
        index=node.next;
    }
    return false;
}
vec3 indirect_irradiance(uint face_id,vec3 point)
{
    float radius=max(.18,grid.w);
    float radius2=radius*radius;
    float spacing=max(grid.w,1e-5);
    ivec3 center=ivec3(floor((point-grid.xyz)/spacing));
    vec3 flux=vec3(0);
    for(int z=-1;z<=1;++z)
    for(int y=-1;y<=1;++y)
    for(int x=-1;x<=1;++x) {
        ivec3 cell=center+ivec3(x,y,z);
        if(any(lessThan(cell,ivec3(0))) ||
           any(greaterThanEqual(cell,ivec3(16))))continue;
        uint id=uint(cell.x+16*(cell.y+16*cell.z));
        uint begin=offsets[id];
        uint end=min(offsets[id+1u],begin+48u);
        for(uint i=begin;i<end;++i) {
            Photon photon=photons[i];
            if(photon.link.y!=face_id)continue;
            vec3 delta=point-photon.position.xyz;
            float dist2=dot(delta,delta);
            if(dist2>=radius2)continue;
            flux+=photon.power.rgb*(1.0-dist2/radius2);
        }
    }
    return flux*(2.0/(PI*PI*radius2));
}
void main()
{
    uint id=gl_GlobalInvocationID.x;
    if(id>=pc.info.x)return;
    Face f=faces[id];
    if(id==description.y || f.emission.w>1.0 || f.emission.w<-.001) {
        for(uint i=0u;i<6u;++i)diffuse_light[id*6u+i]=vec4(0);
        return;
    }
    vec3 normal_base=normalize(f.normal.xyz);
    // Three inset vertex samples for each side interpolate across large
    // triangles. This avoids flat lighting on off-screen walls and floors
    // without casting per-reflected-pixel shadow rays.
    for(uint vertex=0u;vertex<3u;++vertex) {
        vec2 bary=vertex==0u?vec2(.07,.07):
                 vertex==1u?vec2(.86,.07):vec2(.07,.86);
        vec3 point=f.origin.xyz+f.u.xyz*bary.x+f.v.xyz*bary.y;
        vec3 indirect=indirect_irradiance(id,point);
        for(uint side=0u;side<2u;++side) {
            vec3 normal=side==0u?normal_base:-normal_base;
            vec3 illumination=indirect;
            for(uint j=0u;j<min(light_count.x,16u);++j) {
                Light light=lights[j];
                vec3 delta=light.position_radius.xyz-point;
                float dist2=dot(delta,delta);
                float reach=max(light.position_radius.w,.001);
                if(dist2<=.0001 || dist2>=reach*reach)continue;
                float distance=sqrt(dist2);
                vec3 direction=delta/distance;
                float lambert=max(dot(normal,direction),0.0);
                if(lambert<=0.0)continue;
                if(blocked(point+normal*.03,direction,
                           max(distance-.06,.03),id))continue;
                float fade=max(0.0,1.0-distance/reach);
                illumination+=light.color_strength.rgb*
                    (light.color_strength.w*lambert*fade*fade/
                     (1.0+.12*dist2));
            }
            diffuse_light[id*6u+side*3u+vertex]=
                vec4(max(illumination,vec3(0.0)),1.0);
        }
    }
}
