#version 450
layout(local_size_x=64) in;
const uint tile_capacity=256u;
struct Particle
{
    vec4 world;
    vec4 velocity;
    vec4 previous;
    vec4 properties;
};
layout(std430,set=0,binding=3) readonly buffer Particles
{
    Particle particles[];
};
layout(std430,set=0,binding=4) buffer Counts
{
    uint counts[];
};
layout(std430,set=0,binding=5) buffer Indices
{
    uint indices[];
};
layout(push_constant) uniform Data
{
    mat4 transform; // view-projection matrix
    vec4 absorption;
    vec4 scattering;
    vec4 lighting; // w particle spacing
    uvec4 sizes;   // width, height, flags, particle count
} pc;

uint scatter_hash(uint x)
{
    // Avalanche all bits. The previous high-bit LCG gave the same offset
    // for hundreds of consecutive groups, creating visible particle bands.
    x^=x>>16u;
    x*=0x7feb352du;
    x^=x>>15u;
    x*=0x846ca68bu;
    return x^(x>>16u);
}

void main()
{
    // Optical LOD only. PBF simulation keeps every particle.
    const uint stride=max(1u,(pc.sizes.z>>24u)&255u);
    const uint group=gl_GlobalInvocationID.x;
    const uint offset=stride==1u?0u:scatter_hash(group)%stride;
    const uint id=group*stride+offset;
    if(id>=pc.sizes.w)return;
    vec4 clip=pc.transform*vec4(particles[id].world.xyz,1);
    if(clip.w<=1e-5 || clip.z<-.2 || clip.z>clip.w+.2)return;
    uint columns=(pc.sizes.x+15u)/16u;
    uint rows=(pc.sizes.y+15u)/16u;
    vec2 center=(clip.xy/clip.w*.5+.5)*vec2(pc.sizes.xy);
    // Coarse optical particles represent more volume. Expand their
    // reconstruction support by cube-root(stride), not their physics size.
    float h=pc.lighting.w*max(1.5,float((pc.sizes.z>>8u)&65535u)/100.0)*
            pow(float(stride),1.0/3.0);
    // Conservative screen-space kernel support plus one full tile halo.
    float projection=abs(pc.transform[1][1]);
    float r=clamp(h*projection*float(pc.sizes.y)*.5/clip.w,1.0,2048.0)+2.0;
    ivec2 lo=clamp(ivec2(floor((center-vec2(r))/16.0)),
                   ivec2(0),ivec2(columns-1u,rows-1u));
    ivec2 hi=clamp(ivec2(floor((center+vec2(r))/16.0)),
                   ivec2(0),ivec2(columns-1u,rows-1u));
    for(int y=lo.y;y<=hi.y;++y)
        for(int x=lo.x;x<=hi.x;++x)
        {
            uint tile=uint(y)*columns+uint(x);
            uint slot=atomicAdd(counts[tile],1u);
            if(slot<tile_capacity)
                indices[tile*tile_capacity+slot]=id;
            // Keep full occupancy count; optics use bounded weighted samples.
        }
}
