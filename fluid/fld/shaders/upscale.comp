#version 450
// Full-resolution depth-aware composite of a shaded, sparse liquid layer.
// Keeps geometry and weapon rendering native-resolution. No raymarch here.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D depth_image;
layout(set=0,binding=1) uniform sampler2D scene_color;
layout(rgba16f,set=0,binding=2) writeonly uniform image2D liquid_output;
layout(rgba16f,set=0,binding=6) readonly uniform image2D fluid_layer;

layout(push_constant) uniform Data
{
    mat4 inverse_view_projection;
    vec4 absorption;
    vec4 scattering;
    vec4 lighting;
    uvec4 sizes;  // full display dimensions, depth convention, particle count
} pc;

vec3 unproject(vec2 ndc,float depth)
{
    vec4 v=pc.inverse_view_projection*vec4(ndc,depth,1.);
    return v.xyz/v.w;
}

void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    ivec2 screen=ivec2(pc.sizes.xy);
    if(any(greaterThanEqual(pixel,screen)))return;
    vec2 uv=(vec2(pixel)+.5)/vec2(screen);
    ivec2 low=imageSize(fluid_layer);
    vec2 coord=uv*vec2(low)-.5;
    ivec2 first=ivec2(floor(coord));
    vec2 fraction=fract(coord);
    float depth=texelFetch(depth_image,pixel,0).r;
    bool reverse=(pc.sizes.z&1u)!=0u;
    bool background=reverse?depth<=.000001:depth>=.999999;
    float scene_t=1e20;
    if(!background)
    {
        vec2 ndc=uv*2.-1.;
        vec3 near_point=unproject(ndc,reverse?.999:.001);
        vec3 far_point=unproject(ndc,reverse?.001:.999);
        vec3 direction=normalize(far_point-near_point);
        scene_t=dot(unproject(ndc,depth)-near_point,direction);
    }

    vec3 color=vec3(0);
    float coverage=0.;
    for(int y=0;y<2;++y)
    for(int x=0;x<2;++x)
    {
        ivec2 sample_pixel=clamp(first+ivec2(x,y),ivec2(0),low-1);
        vec4 sample_color=imageLoad(fluid_layer,sample_pixel);
        if(sample_color.a<0.)continue;
        // Do not leak water over foreground geometry that lies closer to
        // the camera. A small tolerance prevents numerical z-fighting.
        if(sample_color.a>scene_t+.025)continue;
        float weight=(x==0?1.-fraction.x:fraction.x)*
                     (y==0?1.-fraction.y:fraction.y);
        color+=sample_color.rgb*weight;
        coverage+=weight;
    }
    const vec3 scene=texelFetch(scene_color,pixel,0).rgb;
    const vec3 composite=coverage>1e-5?
        mix(scene,color/coverage,clamp(coverage,0.,1.)):scene;
    imageStore(liquid_output,pixel,vec4(composite,1.));
}
