#version 450
layout(local_size_x=64) in;
layout(std430,set=0,binding=4) buffer Counts { uint counts[]; };
layout(push_constant) uniform Data
{
    mat4 transform;
    vec4 absorption;
    vec4 scattering;
    vec4 lighting;
    uvec4 sizes; // x width, y height
} pc;
void main()
{
    uint tiles=((pc.sizes.x+15u)/16u)*((pc.sizes.y+15u)/16u);
    uint id=gl_GlobalInvocationID.x;
    if(id<tiles)counts[id]=0u;
}
