#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;

struct Particle
{
    vec4 position;
    vec4 velocity;
    vec4 previous;
    vec4 physical;
};
layout(std430,set=0,binding=0) buffer Particles { Particle particles[]; };
layout(std430,set=0,binding=1) buffer Heads { int heads[]; };
layout(std430,set=0,binding=2) buffer Next { int next_particle[]; };
layout(std430,set=0,binding=3) buffer Lambdas { float lambdas[]; };
layout(std430,set=0,binding=4) buffer Deltas { vec4 deltas[]; };
layout(std430,set=0,binding=5) buffer SurfaceNormals { vec4 surface_normals[]; };
struct Collider { vec4 minimum; vec4 maximum; };
layout(std430,set=0,binding=6) readonly buffer StaticColliders
{
    Collider colliders[];
};
#if defined(FLD_USE_BVH)
// Generic std430 BVH node format; the compact direct-collision shader never
// compiles this traversal or reserves its register-heavy local stack.
struct BVHNode {vec4 minimum;vec4 maximum;uvec4 links;};
layout(std430,set=0,binding=7) readonly buffer CollisionBVH
{
    BVHNode nodes[];
};
#endif

layout(push_constant) uniform Settings
{
    vec4 gravity_dt; // xyz gravity, w substep seconds
    vec4 liquid;     // x rest density, y spacing, z h, w floor height
    vec4 contact;    // x sigma, y cos(theta advancing), z cos(receding), w viscosity
    uvec4 indices;   // x particles, y buckets, z iterations, w box count
} pc;

const float pi=3.14159265358979323846;
const int invalid=-1;

ivec3 cell(vec3 p)
{
    return ivec3(floor(p/pc.liquid.z));
}
uint hash_cell(ivec3 c)
{
    uvec3 u=uvec3(c);
    // The host allocates 16384 buckets (a power of two). Bit masking
    // avoids integer division in every 27-cell SPH neighborhood lookup.
    return (u.x*73856093u ^ u.y*19349663u ^ u.z*83492791u)
        & (pc.indices.y-1u);
}
float poly6(float r2,float h)
{
    float h2=h*h;
    if(r2>=h2)return 0.;
    float q=h2-r2;
    float h3=h*h*h;
    return 315.0/(64.0*pi*h3*h3*h3)*q*q*q;
}
vec3 spiky(vec3 r,float h)
{
    float len=length(r);
    if(len<1e-6 || len>=h)return vec3(0);
    float h2=h*h,h6=h2*h2*h2;
    return -45.0/(pi*h6)*pow(h-len,2.)*r/len;
}
// Akinci et al. (2013) surface-cohesion kernel, SI dimensions 1/m^3.
// Positive at normal particle spacing, repulsive at extremely short range.
float cohesion_kernel(float r,float h)
{
    if(r<=1e-6 || r>=h)return 0.;
    float u=r/h;
    float k=pow(1.-u,3.)*u*u*u;
    if(u<=.5)k=2.*k-1./64.;
    return (32./pi)*k/(h*h*h);
}


int broadphase(vec3 p,float radius,out uint candidates[16])
{
#if defined(FLD_USE_BVH)
    uint stack[32];
    int top=1,found=0;
    stack[0]=0u;
    while(top>0)
    {
        BVHNode n=nodes[stack[--top]];
        if(any(lessThan(p,n.minimum.xyz-vec3(radius))) ||
           any(greaterThan(p,n.maximum.xyz+vec3(radius))))
            continue;
        if(n.links.w!=0xffffffffu)
        {
            if(found>=16)return -1; // fall back without missing collisions
            candidates[found++]=n.links.w;
        }
        else
        {
            if(top+2>32)return -1;
            stack[top++]=n.links.x;
            stack[top++]=n.links.y;
        }
    }
    return found;
#else
    return -1;
#endif
}

vec3 project_colliders(vec3 p,float r,out vec3 normal)
{
    normal=vec3(0);
    if(p.y<pc.liquid.w+r)
    {
        p.y=pc.liquid.w+r;
        normal=vec3(0,1,0);
    }
    uint candidates[16];
    int selected=broadphase(p,r,candidates);
    uint count=selected<0?pc.indices.w:uint(selected);
    for(uint cursor=0u;cursor<count;++cursor)
    {
        uint i=selected<0?cursor:candidates[cursor];
        vec3 low=colliders[i].minimum.xyz-vec3(r);
        vec3 high=colliders[i].maximum.xyz+vec3(r);
        if(any(lessThanEqual(p,low)) || any(greaterThanEqual(p,high)))
            continue;
        // The closest face of the expanded AABB resolves penetration.
        // This supports side walls and cube tops with identical code.
        vec3 a=p-low,b=high-p;
        float best=a.x;
        int face=0;
        if(b.x<best){best=b.x;face=1;}
        if(a.y<best){best=a.y;face=2;}
        if(b.y<best){best=b.y;face=3;}
        if(a.z<best){best=a.z;face=4;}
        if(b.z<best){face=5;}
        if(face==0){p.x=low.x;normal=vec3(-1,0,0);}
        if(face==1){p.x=high.x;normal=vec3(1,0,0);}
        if(face==2){p.y=low.y;normal=vec3(0,-1,0);}
        if(face==3){p.y=high.y;normal=vec3(0,1,0);}
        if(face==4){p.z=low.z;normal=vec3(0,0,-1);}
        if(face==5){p.z=high.z;normal=vec3(0,0,1);}
    }
    // Floor always wins if a cube's expanded underside overlaps the plane.
    p.y=max(p.y,pc.liquid.w+r);
    return p;
}
vec3 contact_normal(vec3 p,float r)
{
    if(p.y<=pc.liquid.w+r+.002)return vec3(0,1,0);
    uint candidates[16];
    int selected=broadphase(p,r+.002,candidates);
    uint count=selected<0?pc.indices.w:uint(selected);
    for(uint cursor=0u;cursor<count;++cursor)
    {
        uint i=selected<0?cursor:candidates[cursor];
        vec3 lo=colliders[i].minimum.xyz-vec3(r);
        vec3 hi=colliders[i].maximum.xyz+vec3(r);
        const float eps=.002;
        if(all(greaterThanEqual(p,lo-vec3(eps))) &&
           all(lessThanEqual(p,hi+vec3(eps))))
        {
            if(abs(p.x-lo.x)<eps)return vec3(-1,0,0);
            if(abs(p.x-hi.x)<eps)return vec3(1,0,0);
            if(abs(p.y-lo.y)<eps)return vec3(0,-1,0);
            if(abs(p.y-hi.y)<eps)return vec3(0,1,0);
            if(abs(p.z-lo.z)<eps)return vec3(0,0,-1);
            if(abs(p.z-hi.z)<eps)return vec3(0,0,1);
        }
    }
    return vec3(0);
}

void main()
{
    uint id=gl_GlobalInvocationID.x;
#if defined(FLD_CLEAR)
    if(id<pc.indices.y)heads[id]=invalid;
#else
    if(id>=pc.indices.x)return;
    Particle p=particles[id];
#if defined(FLD_PREDICT)
    p.previous=p.position;
    p.velocity.xyz+=pc.gravity_dt.xyz*pc.gravity_dt.w;
    p.position.xyz+=p.velocity.xyz*pc.gravity_dt.w;
    vec3 normal;
    p.position.xyz=project_colliders(p.position.xyz,p.position.w,normal);
    particles[id]=p;
#elif defined(FLD_BUILD)
    uint bucket=hash_cell(cell(p.position.xyz));
    next_particle[id]=atomicExchange(heads[bucket],int(id));
#elif defined(FLD_LAMBDA)
    float h=pc.liquid.z;
    float rho=p.physical.y*poly6(0.,h);
    vec3 grad_self=vec3(0);
    float sum_grad2=0.;
    ivec3 at=cell(p.position.xyz);
    for(int z=-1;z<=1;++z)
    for(int y=-1;y<=1;++y)
    for(int x=-1;x<=1;++x)
    {
        ivec3 n=at+ivec3(x,y,z);
        int j=heads[hash_cell(n)];
        uint visited=0u;
        while(j!=invalid && visited++<pc.indices.x)
        {
            Particle q=particles[j];
            if(j!=int(id) && all(equal(cell(q.position.xyz),n)))
            {
                vec3 d=p.position.xyz-q.position.xyz;
                rho+=q.physical.y*poly6(dot(d,d),h);
                vec3 g=q.physical.y/pc.liquid.x*spiky(d,h);
                grad_self+=g;
                sum_grad2+=dot(g,g);
            }
            j=next_particle[j];
        }
    }
    sum_grad2+=dot(grad_self,grad_self);
    // Keep a bounded tensile branch at free surfaces. Clamping at -0.065
    // left surface particles almost unconstrained, so the drop separated
    // into independent beads after impact. Cap the correction for stability.
    float error=max(-.20,rho/pc.liquid.x-1.);
    lambdas[id]=-error/(sum_grad2+1e-4);
#elif defined(FLD_DELTA)
    vec3 correction=vec3(0);
    float h=pc.liquid.z;
    ivec3 at=cell(p.position.xyz);
    for(int z=-1;z<=1;++z)
    for(int y=-1;y<=1;++y)
    for(int x=-1;x<=1;++x)
    {
        ivec3 n=at+ivec3(x,y,z);
        int j=heads[hash_cell(n)];
        uint visited=0u;
        while(j!=invalid && visited++<pc.indices.x)
        {
            Particle q=particles[j];
            if(j!=int(id) && all(equal(cell(q.position.xyz),n)))
            {
                vec3 d=p.position.xyz-q.position.xyz;
                float w=poly6(dot(d,d),h)/
                         max(poly6(.09*h*h,h),1e-7);
                // Short-range repulsion prevents tensile clumping while the
                // bounded negative density constraint maintains connectivity.
                float scorr=-.002*pow(w,4.);
                correction+=(lambdas[id]+lambdas[j]+scorr)*
                             q.physical.y/pc.liquid.x*spiky(d,h);
            }
            j=next_particle[j];
        }
    }
    // Jacobi updates: no reads of partially corrected neighbors.
    float m=length(correction);
    float max_step=.25*pc.liquid.y;
    deltas[id]=vec4(m>max_step?correction*max_step/m:correction,0);
#elif defined(FLD_APPLY)
    p.position.xyz+=deltas[id].xyz;
    vec3 normal;
    p.position.xyz=project_colliders(p.position.xyz,p.position.w,normal);
    particles[id]=p;
#elif defined(FLD_FINALIZE)
    vec3 v=(p.position.xyz-p.previous.xyz)/max(pc.gravity_dt.w,1e-5);
    // Simple contact friction, deliberately not the unified implicit
    // Probst-Teschner solver (future quantitative capillary milestone).
    vec3 n=contact_normal(p.position.xyz,p.position.w);
    if(dot(n,n)>0.)
    {
        v-=n*min(0.,dot(v,n));
        float pin=max(0.,pc.contact.z-pc.contact.y)*
                  pc.contact.x*6.2831853*p.position.w/
                  max(p.physical.y,1e-6);
        vec3 tangent=v-n*dot(v,n);
        float speed=length(tangent);
        float drag=pin*pc.gravity_dt.w;
        v-=tangent*(speed>drag ?
                    clamp(drag/max(speed,1e-7),0.,.65):.65);
    }
    // Prevent a single extreme correction from making a ballistic jet.
    float speed=length(v);
    if(speed>18.)v*=18./speed;
    p.velocity.xyz=v;
    particles[id]=p;
#elif defined(FLD_NORMAL)
    float h=pc.liquid.z;
    vec3 gradient=vec3(0);
    ivec3 at=cell(p.position.xyz);
    for(int z=-1;z<=1;++z)
    for(int y=-1;y<=1;++y)
    for(int x=-1;x<=1;++x)
    {
        ivec3 n=at+ivec3(x,y,z);
        int j=heads[hash_cell(n)];
        uint visited=0u;
        while(j!=invalid && visited++<pc.indices.x)
        {
            Particle q=particles[j];
            if(j!=int(id) && all(equal(cell(q.position.xyz),n)))
            {
                gradient-=q.physical.x*
                          spiky(p.position.xyz-q.position.xyz,h);
            }
            j=next_particle[j];
        }
    }
    surface_normals[id]=vec4(gradient,length(gradient));
#elif defined(FLD_CAPILLARY)
    vec3 n=surface_normals[id].xyz;
    float magnitude=surface_normals[id].w;
    bool surface=magnitude>=1e-5;
    vec3 n_hat=surface?n/magnitude:vec3(0.);
    float curvature=0.;
    vec3 cohesion=vec3(0.);
    ivec3 at=cell(p.position.xyz);
    float h=pc.liquid.z;
    for(int z=-1;z<=1;++z)
    for(int y=-1;y<=1;++y)
    for(int x=-1;x<=1;++x)
    {
        ivec3 c=at+ivec3(x,y,z);
        int j=heads[hash_cell(c)];
        uint visited=0u;
        while(j!=invalid && visited++<pc.indices.x)
        {
            Particle q=particles[j];
            if(j!=int(id) && all(equal(cell(q.position.xyz),c)))
            {
                vec3 d=p.position.xyz-q.position.xyz;
                float r=length(d);
                if(r>1e-6 && r<h)
                {
                    // Pairwise surface cohesion: equal particle masses exert
                    // opposite accelerations, including between droplets.
                    cohesion-=pc.contact.x*q.physical.y*
                               cohesion_kernel(r,h)*d/r;
                }
                if(surface)
                {
                    vec3 nj=surface_normals[j].xyz;
                    float lj=length(nj);
                    if(lj>1e-5)
                        curvature+=q.physical.x*
                                   dot(nj/lj-n_hat,spiky(d,h));
                }
            }
            j=next_particle[j];
        }
    }
    // Curvature plus pair cohesion use the material's surface tension.
    // Both contributions are bounded per substep for coarse real-time SPH.
    vec3 acceleration=cohesion;
    if(surface)
        acceleration-=pc.contact.x/pc.liquid.x*abs(curvature)*n;
    float speed=length(acceleration);
    float bound=.15*pc.liquid.y/
                max(pc.gravity_dt.w*pc.gravity_dt.w,1e-8);
    if(speed>bound)acceleration*=bound/speed;
    p.velocity.xyz+=acceleration*pc.gravity_dt.w;
    particles[id]=p;
#elif defined(FLD_VISCOSITY)
    // XSPH velocity blending is evaluated from a read-only neighborhood.
    // Store the correction separately; never mix old/new neighbor velocity
    // within one compute dispatch (which is GPU ordering dependent).
    vec3 sum=vec3(0);
    float weight=0.;
    float h=pc.liquid.z;
    ivec3 at=cell(p.position.xyz);
    for(int z=-1;z<=1;++z)
    for(int y=-1;y<=1;++y)
    for(int x=-1;x<=1;++x)
    {
        ivec3 n=at+ivec3(x,y,z);
        int j=heads[hash_cell(n)];
        uint visited=0u;
        while(j!=invalid && visited++<pc.indices.x)
        {
            Particle q=particles[j];
            if(j!=int(id) && all(equal(cell(q.position.xyz),n)))
            {
                vec3 d=p.position.xyz-q.position.xyz;
                float w=q.physical.x*poly6(dot(d,d),h);
                sum+=q.velocity.xyz*w;
                weight+=w;
            }
            j=next_particle[j];
        }
    }
    float cohesion=.22;
    vec3 change=weight>1e-6?
        (sum/weight-p.velocity.xyz)*cohesion:vec3(0);
    deltas[id]=vec4(change,0);
#elif defined(FLD_VISCOSITY_APPLY)
    p.velocity.xyz+=deltas[id].xyz;
    particles[id]=p;
#endif
#endif
}
