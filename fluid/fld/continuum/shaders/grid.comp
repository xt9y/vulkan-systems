#version 450
// Continuous free-surface liquid. All fields live in one GPU storage buffer.
// Staggered MAC faces + conservative cell-centered VOF + pressure projection.
layout(local_size_x=8,local_size_y=8,local_size_z=4) in;
layout(std430,set=0,binding=0) buffer Grid { float fields[]; };
struct Box { vec4 lo; vec4 hi; };
layout(std430,set=0,binding=1) readonly buffer Boxes { Box boxes[]; };

layout(push_constant) uniform Parameters
{
    vec4 origin_cell;       // xyz origin, w cell width (metres)
    vec4 spawn_radius;      // xyz initial sphere center, w initial radius
    vec4 physical;          // dt, density, gravity Y, kinematic viscosity
    vec4 interface_data;    // surface tension, advance/recede angles, unused
    uvec4 dims;             // nx,ny,nz,number of AABBs
    uvec4 flags;            // active VOF (0/1), pressure source (0/1)
    vec4 rheology;          // mu_0, mu_infinity, lambda, n (Carreau)
    vec4 contact;           // substrate drag (s^-1), reserved
} pc;

uint nx(){return pc.dims.x;}
uint ny(){return pc.dims.y;}
uint nz(){return pc.dims.z;}
uint nc(){return nx()*ny()*nz();}
uint nu(){return (nx()+1u)*ny()*nz();}
uint nv(){return nx()*(ny()+1u)*nz();}
uint nw(){return nx()*ny()*(nz()+1u);}
uint vof_off(uint bank){return bank*nc();}
uint pressure_off(uint bank){return (2u+bank)*nc();}
uint divergence_off(){return 4u*nc();}
uint curvature_off(){return 5u*nc();}
uint solid_off(){return 6u*nc();}
uint u_off(uint bank){return 7u*nc()+bank*nu();}
uint v_off(uint bank){return 7u*nc()+2u*nu()+bank*nv();}
uint w_off(uint bank){return 7u*nc()+2u*nu()+2u*nv()+bank*nw();}

bool valid(ivec3 c){return all(greaterThanEqual(c,ivec3(0))) &&
                          all(lessThan(c,ivec3(pc.dims.xyz)));}
uint ci(ivec3 c){return (uint(c.z)*ny()+uint(c.y))*nx()+uint(c.x);}
uint ui(ivec3 c){return (uint(c.z)*ny()+uint(c.y))*(nx()+1u)+uint(c.x);}
uint vi(ivec3 c){return (uint(c.z)*(ny()+1u)+uint(c.y))*nx()+uint(c.x);}
uint wi(ivec3 c){return (uint(c.z)*ny()+uint(c.y))*nx()+uint(c.x);}
bool solid(ivec3 c){return !valid(c) || fields[solid_off()+ci(c)]>.5;}
float fraction(ivec3 c,uint bank)
{
    if(!valid(c) || solid(c))return 0.;
    return fields[vof_off(bank)+ci(c)];
}
bool wet(ivec3 c){return fraction(c,pc.flags.x)>.025;}
float face_u(ivec3 c,uint bank)
{
    c=clamp(c,ivec3(0),ivec3(int(nx()),int(ny())-1,int(nz())-1));
    return fields[u_off(bank)+ui(c)];
}
float face_v(ivec3 c,uint bank)
{
    c=clamp(c,ivec3(0),ivec3(int(nx())-1,int(ny()),int(nz())-1));
    return fields[v_off(bank)+vi(c)];
}
float face_w(ivec3 c,uint bank)
{
    c=clamp(c,ivec3(0),ivec3(int(nx())-1,int(ny())-1,int(nz())));
    return fields[w_off(bank)+wi(c)];
}
float tri_u(vec3 c,uint bank)
{
    ivec3 b=ivec3(floor(c));vec3 t=fract(c);float sum=0.;
    for(int z=0;z<2;++z)for(int y=0;y<2;++y)for(int x=0;x<2;++x)
    {
        vec3 w=mix(vec3(1.)-t,t,vec3(x,y,z));
        sum+=face_u(b+ivec3(x,y,z),bank)*w.x*w.y*w.z;
    }
    return sum;
}
float tri_v(vec3 c,uint bank)
{
    ivec3 b=ivec3(floor(c));vec3 t=fract(c);float sum=0.;
    for(int z=0;z<2;++z)for(int y=0;y<2;++y)for(int x=0;x<2;++x)
    {
        vec3 w=mix(vec3(1.)-t,t,vec3(x,y,z));
        sum+=face_v(b+ivec3(x,y,z),bank)*w.x*w.y*w.z;
    }
    return sum;
}
float tri_w(vec3 c,uint bank)
{
    ivec3 b=ivec3(floor(c));vec3 t=fract(c);float sum=0.;
    for(int z=0;z<2;++z)for(int y=0;y<2;++y)for(int x=0;x<2;++x)
    {
        vec3 w=mix(vec3(1.)-t,t,vec3(x,y,z));
        sum+=face_w(b+ivec3(x,y,z),bank)*w.x*w.y*w.z;
    }
    return sum;
}
vec3 velocity(vec3 pos)
{
    vec3 g=(pos-pc.origin_cell.xyz)/pc.origin_cell.w;
    return vec3(tri_u(g-vec3(0.,.5,.5),0u),
                tri_v(g-vec3(.5,0.,.5),0u),
                tri_w(g-vec3(.5,.5,0.),0u));
}
// Approximate symmetric strain rate from MAC-face velocity gradients.
// The default Newtonian branch has no extra sampling overhead.
float apparent_kinematic_viscosity(ivec3 c)
{
    if(pc.rheology.y<=0.)return pc.physical.w;
    float h=max(pc.origin_cell.w,1e-5);
    float dudx=(face_u(c+ivec3(1,0,0),0u)-face_u(c,0u))/h;
    float dvdy=(face_v(c+ivec3(0,1,0),0u)-face_v(c,0u))/h;
    float dwdz=(face_w(c+ivec3(0,0,1),0u)-face_w(c,0u))/h;
    float dudy=(face_u(c+ivec3(0,1,0),0u)-
                face_u(c-ivec3(0,1,0),0u))/(2.*h);
    float dvdx=(face_v(c+ivec3(1,0,0),0u)-
                face_v(c-ivec3(1,0,0),0u))/(2.*h);
    float dudz=(face_u(c+ivec3(0,0,1),0u)-
                face_u(c-ivec3(0,0,1),0u))/(2.*h);
    float dwdx=(face_w(c+ivec3(1,0,0),0u)-
                face_w(c-ivec3(1,0,0),0u))/(2.*h);
    float dvdz=(face_v(c+ivec3(0,0,1),0u)-
                face_v(c-ivec3(0,0,1),0u))/(2.*h);
    float dwdy=(face_w(c+ivec3(0,1,0),0u)-
                face_w(c-ivec3(0,1,0),0u))/(2.*h);
    float gamma=sqrt(max(0.,
        2.*(dudx*dudx+dvdy*dvdy+dwdz*dwdz)+
        (dudy+dvdx)*(dudy+dvdx)+
        (dudz+dwdx)*(dudz+dwdx)+
        (dvdz+dwdy)*(dvdz+dwdy)));
    float t=pc.rheology.z*gamma;
    float mu=mix(pc.rheology.y,pc.rheology.x,
                 pow(1.+t*t,(pc.rheology.w-1.)*.5));
    return mu/max(pc.physical.y,1e-3);
}
float contact_damping(ivec3 c)
{
    if(pc.contact.x<=0.)return 1.;
    // Acts near a solid surface, NOT uniformly throughout the drop.
    bool touching=solid(c-ivec3(0,1,0)) ||
                  solid(c-ivec3(0,2,0));
    return touching?exp(-pc.contact.x*pc.physical.x):1.;
}
vec3 center(ivec3 c){return pc.origin_cell.xyz+
                             (vec3(c)+vec3(.5))*pc.origin_cell.w;}
bool blocked_world(vec3 world)
{
    // Occupy a cell only when most of its actual volume intersects a
    // collider. The old any-overlap rule padded every cube and wall by up
    // to one grid cell, leaving an obvious dry moat around its edges.
    float h=pc.origin_cell.w;
    vec3 half_cell=vec3(.5*h);
    vec3 lo=world-half_cell,hi=world+half_cell;
    float cell_volume=h*h*h;
    for(uint i=0u;i<pc.dims.w;++i)
    {
        vec3 overlap=max(vec3(0.),
            min(hi,boxes[i].hi.xyz)-max(lo,boxes[i].lo.xyz));
        if(overlap.x*overlap.y*overlap.z>.50*cell_volume)
            return true;
    }
    return false;
}
float pressure(ivec3 c,uint bank)
{
    return wet(c)?fields[pressure_off(bank)+ci(c)]:0.;
}
vec3 density_normal(ivec3 c)
{
    vec3 g=vec3(
        fraction(c+ivec3(1,0,0),pc.flags.x)-fraction(c-ivec3(1,0,0),pc.flags.x),
        fraction(c+ivec3(0,1,0),pc.flags.x)-fraction(c-ivec3(0,1,0),pc.flags.x),
        fraction(c+ivec3(0,0,1),pc.flags.x)-fraction(c-ivec3(0,0,1),pc.flags.x));
    float n=length(g);
    if(n<1e-5)return vec3(0.);
    vec3 result=-g/n;
    // Contact angle at horizontal solid surfaces: constrain the interface
    // normal, while the pressure solve still enforces no penetration.
    if(solid(c-ivec3(0,1,0)) && result.y>-.95)
    {
        vec2 horizontal=result.xz;
        float d=length(horizontal);
        if(d>1e-5)
        {
            // A coarse advancing/receding contact-angle model. The liquid
            // front chooses its angle from tangential motion rather than
            // always forcing the advancing angle. It reduces perpetual
            // retraction but is not a sub-cell dynamic wetting solver.
            vec2 front=horizontal/d;
            vec2 tangent=vec2(
                .5*(face_u(c,0u)+face_u(c+ivec3(1,0,0),0u)),
                .5*(face_w(c,0u)+face_w(c+ivec3(0,0,1),0u)));
            float contact_speed=dot(tangent,front);
            float advance=smoothstep(-.018,.018,contact_speed);
            float angle=mix(pc.interface_data.z,
                            pc.interface_data.y,advance);
            result=vec3(front.x*sin(angle),cos(angle),
                        front.y*sin(angle));
        }
    }
    return result;
}
float surface_pressure(ivec3 c)
{
    if(!valid(c))return 0.;
    return pc.interface_data.x*fields[curvature_off()+ci(c)];
}
float free_pressure(ivec3 fluid_cell,ivec3 neighbor,uint pbank)
{
    if(wet(neighbor))return pressure(neighbor,pbank);
    if(solid(neighbor))return 0.;
    return surface_pressure(fluid_cell);
}
// The same face flux is evaluated by both adjacent cells. An outgoing
// donor budget prevents negative volume; an incoming cell budget prevents
// overfilling. Flux limiting preserves the finite-volume global mass sum.
float outgoing(ivec3 c)
{
    if(!valid(c) || solid(c))return 0.;
    return fraction(c,pc.flags.x)*(
        max(0.,face_u(c+ivec3(1,0,0),0u))+
        max(0.,-face_u(c,0u))+
        max(0.,face_v(c+ivec3(0,1,0),0u))+
        max(0.,-face_v(c,0u))+
        max(0.,face_w(c+ivec3(0,0,1),0u))+
        max(0.,-face_w(c,0u)));
}
float incoming(ivec3 c)
{
    if(!valid(c) || solid(c))return 0.;
    return max(0.,-face_u(c+ivec3(1,0,0),0u))*
               fraction(c+ivec3(1,0,0),pc.flags.x)+
           max(0.,face_u(c,0u))*
               fraction(c-ivec3(1,0,0),pc.flags.x)+
           max(0.,-face_v(c+ivec3(0,1,0),0u))*
               fraction(c+ivec3(0,1,0),pc.flags.x)+
           max(0.,face_v(c,0u))*
               fraction(c-ivec3(0,1,0),pc.flags.x)+
           max(0.,-face_w(c+ivec3(0,0,1),0u))*
               fraction(c+ivec3(0,0,1),pc.flags.x)+
           max(0.,face_w(c,0u))*
               fraction(c-ivec3(0,0,1),pc.flags.x);
}
float supply(ivec3 c)
{
    float amount=fraction(c,pc.flags.x);
    return min(1.,amount/max(1e-10,pc.physical.x/pc.origin_cell.w*outgoing(c)));
}
float capacity(ivec3 c)
{
    float amount=fraction(c,pc.flags.x);
    float available=1.-amount+pc.physical.x/pc.origin_cell.w*outgoing(c);
    return clamp(available/max(1e-10,pc.physical.x/pc.origin_cell.w*incoming(c)),0.,1.);
}
float limited_flux(float speed,ivec3 left,ivec3 right)
{
    if(speed>=0.)
        return speed*fraction(left,pc.flags.x)*
               min(supply(left),capacity(right));
    return speed*fraction(right,pc.flags.x)*
           min(supply(right),capacity(left));
}

void main()
{
    ivec3 c=ivec3(gl_GlobalInvocationID.xyz);
    bool inside=valid(c);
    float h=pc.origin_cell.w,dt=pc.physical.x;

#if defined(CONT_SEED)
    if(inside)
    {
        vec3 point=center(c);
        float boundary=length(point-pc.spawn_radius.xyz)-pc.spawn_radius.w;
        float f=clamp(.5-boundary/h,0.,1.);
        bool occupied=blocked_world(point);
        fields[solid_off()+ci(c)]=occupied?1.:0.;
        fields[vof_off(0u)+ci(c)]=occupied?0.:f;
        fields[vof_off(1u)+ci(c)]=occupied?0.:f;
        fields[pressure_off(0u)+ci(c)]=0.;
        fields[pressure_off(1u)+ci(c)]=0.;
        fields[divergence_off()+ci(c)]=0.;
        fields[curvature_off()+ci(c)]=0.;
    }
    if(c.x<=int(nx()) && c.y<int(ny()) && c.z<int(nz()))
    {
        fields[u_off(0u)+ui(c)]=0.;fields[u_off(1u)+ui(c)]=0.;
    }
    if(c.x<int(nx()) && c.y<=int(ny()) && c.z<int(nz()))
    {
        fields[v_off(0u)+vi(c)]=0.;fields[v_off(1u)+vi(c)]=0.;
    }
    if(c.x<int(nx()) && c.y<int(ny()) && c.z<=int(nz()))
    {
        fields[w_off(0u)+wi(c)]=0.;fields[w_off(1u)+wi(c)]=0.;
    }
#elif defined(CONT_ADVECT_VELOCITY)
    // Air is not simulated as falling water. Keep velocities outside
    // the active liquid and its immediate interface at zero so numerical
    // VOF traces cannot be transported across the entire finite grid.
    vec3 base=pc.origin_cell.xyz;
    float nu=pc.physical.w;
    // Sparse gating: avoid evaluating nine derivatives of the velocity
    // field in the overwhelmingly empty portion of the simulation box.
    if(pc.rheology.y>0. && (wet(c) ||
       wet(c-ivec3(1,0,0)) || wet(c-ivec3(0,1,0)) ||
       wet(c-ivec3(0,0,1))))
        nu=apparent_kinematic_viscosity(c);
    float drag=contact_damping(c);
    if(c.x<=int(nx()) && c.y<int(ny()) && c.z<int(nz()))
    {
        ivec3 l=c-ivec3(1,0,0);
        vec3 world=base+(vec3(c)+vec3(0.,.5,.5))*h;
        float value=0.;
        if(!solid(l)&&!solid(c) && (wet(l)||wet(c)))
        {
            vec3 old=velocity(world);
            value=tri_u((world-old*dt-base)/h-vec3(0.,.5,.5),0u);
            float diff=face_u(c+ivec3(1,0,0),0u)+face_u(c-ivec3(1,0,0),0u)
                      +face_u(c+ivec3(0,1,0),0u)+face_u(c-ivec3(0,1,0),0u)
                      +face_u(c+ivec3(0,0,1),0u)+face_u(c-ivec3(0,0,1),0u)-6.*face_u(c,0u);
            value+=clamp(nu*dt/(h*h),0.,1./6.)*diff;
            value*=drag;
        }
        fields[u_off(1u)+ui(c)]=clamp(value,-8.,8.);
    }
    if(c.x<int(nx()) && c.y<=int(ny()) && c.z<int(nz()))
    {
        ivec3 bottom=c-ivec3(0,1,0);
        vec3 world=base+(vec3(c)+vec3(.5,0.,.5))*h;
        float value=0.;
        if(!solid(bottom)&&!solid(c) && (wet(bottom)||wet(c)))
        {
            vec3 old=velocity(world);
            value=tri_v((world-old*dt-base)/h-vec3(.5,0.,.5),0u);
            value+=pc.physical.z*dt;
            float diff=face_v(c+ivec3(1,0,0),0u)+face_v(c-ivec3(1,0,0),0u)
                      +face_v(c+ivec3(0,1,0),0u)+face_v(c-ivec3(0,1,0),0u)
                      +face_v(c+ivec3(0,0,1),0u)+face_v(c-ivec3(0,0,1),0u)-6.*face_v(c,0u);
            value+=clamp(nu*dt/(h*h),0.,1./6.)*diff;
            value*=drag;
        }
        fields[v_off(1u)+vi(c)]=clamp(value,-8.,8.);
    }
    if(c.x<int(nx()) && c.y<int(ny()) && c.z<=int(nz()))
    {
        ivec3 back=c-ivec3(0,0,1);
        vec3 world=base+(vec3(c)+vec3(.5,.5,0.))*h;
        float value=0.;
        if(!solid(back)&&!solid(c) && (wet(back)||wet(c)))
        {
            vec3 old=velocity(world);
            value=tri_w((world-old*dt-base)/h-vec3(.5,.5,0.),0u);
            float diff=face_w(c+ivec3(1,0,0),0u)+face_w(c-ivec3(1,0,0),0u)
                      +face_w(c+ivec3(0,1,0),0u)+face_w(c-ivec3(0,1,0),0u)
                      +face_w(c+ivec3(0,0,1),0u)+face_w(c-ivec3(0,0,1),0u)-6.*face_w(c,0u);
            value+=clamp(nu*dt/(h*h),0.,1./6.)*diff;
            value*=drag;
        }
        fields[w_off(1u)+wi(c)]=clamp(value,-8.,8.);
    }
#elif defined(CONT_CURVATURE)
    if(!inside)return;
    // The sign convention is outward interface normal.
    vec3 n1=density_normal(c+ivec3(1,0,0));
    vec3 n0=density_normal(c-ivec3(1,0,0));
    vec3 m1=density_normal(c+ivec3(0,1,0));
    vec3 m0=density_normal(c-ivec3(0,1,0));
    vec3 k1=density_normal(c+ivec3(0,0,1));
    vec3 k0=density_normal(c-ivec3(0,0,1));
    float curvature=(n1.x-n0.x+m1.y-m0.y+k1.z-k0.z)/(2.*h);
    fields[curvature_off()+ci(c)]=clamp(curvature,-2./h,2./h);
#elif defined(CONT_DIVERGENCE)
    if(!inside)return;
    float div=(face_u(c+ivec3(1,0,0),1u)-face_u(c,1u)+
               face_v(c+ivec3(0,1,0),1u)-face_v(c,1u)+
               face_w(c+ivec3(0,0,1),1u)-face_w(c,1u))/h;
    fields[divergence_off()+ci(c)]=wet(c)?div:0.;
#elif defined(CONT_PRESSURE)
    if(!inside)return;
    uint dst=1u-pc.flags.y;
    if(!wet(c)){fields[pressure_off(dst)+ci(c)]=0.;return;}
    float sum=0.;float count=0.;
    for(int axis=0;axis<3;++axis)
    for(int direction=-1;direction<=1;direction+=2)
    {
        ivec3 offset=ivec3(0);
        offset[axis]=direction;
        ivec3 adjacent=c+offset;
        if(solid(adjacent))continue; // Neumann no-penetration boundary
        ++count;
        sum+=free_pressure(c,adjacent,pc.flags.y);
    }
    float rhs=pc.physical.y*fields[divergence_off()+ci(c)]/max(dt,1e-6);
    fields[pressure_off(dst)+ci(c)]=count>0.?
        (sum-rhs*h*h)/count:0.;
#elif defined(CONT_PROJECT)
    if(c.x<=int(nx()) && c.y<int(ny()) && c.z<int(nz()))
    {
        ivec3 l=c-ivec3(1,0,0);
        float value=0.;
        if(!solid(l)&&!solid(c) && (wet(l)||wet(c)))
        {
            float pL=wet(l)?pressure(l,pc.flags.y):surface_pressure(c);
            float pR=wet(c)?pressure(c,pc.flags.y):surface_pressure(l);
            value=face_u(c,1u)-dt/(pc.physical.y*h)*(pR-pL);
        }
        fields[u_off(0u)+ui(c)]=clamp(value,-8.,8.);
    }
    if(c.x<int(nx()) && c.y<=int(ny()) && c.z<int(nz()))
    {
        ivec3 bottom=c-ivec3(0,1,0);
        float value=0.;
        if(!solid(bottom)&&!solid(c) && (wet(bottom)||wet(c)))
        {
            float pB=wet(bottom)?pressure(bottom,pc.flags.y):surface_pressure(c);
            float pT=wet(c)?pressure(c,pc.flags.y):surface_pressure(bottom);
            value=face_v(c,1u)-dt/(pc.physical.y*h)*(pT-pB);
        }
        fields[v_off(0u)+vi(c)]=clamp(value,-8.,8.);
    }
    if(c.x<int(nx()) && c.y<int(ny()) && c.z<=int(nz()))
    {
        ivec3 back=c-ivec3(0,0,1);
        float value=0.;
        if(!solid(back)&&!solid(c) && (wet(back)||wet(c)))
        {
            float pB=wet(back)?pressure(back,pc.flags.y):surface_pressure(c);
            float pF=wet(c)?pressure(c,pc.flags.y):surface_pressure(back);
            value=face_w(c,1u)-dt/(pc.physical.y*h)*(pF-pB);
        }
        fields[w_off(0u)+wi(c)]=clamp(value,-8.,8.);
    }
#elif defined(CONT_ADVECT_VOLUME)
    if(!inside)return;
    if(solid(c)){fields[vof_off(1u-pc.flags.x)+ci(c)]=0.;return;}
    float own=fraction(c,pc.flags.x);
    // Shared limited face flux: unlike independent cell clamping, this
    // conserves global liquid volume for an enclosed grid (up to roundoff).
    float xp=limited_flux(face_u(c+ivec3(1,0,0),0u),c,c+ivec3(1,0,0));
    float xm=limited_flux(face_u(c,0u),c-ivec3(1,0,0),c);
    float yp=limited_flux(face_v(c+ivec3(0,1,0),0u),c,c+ivec3(0,1,0));
    float ym=limited_flux(face_v(c,0u),c-ivec3(0,1,0),c);
    float zp=limited_flux(face_w(c+ivec3(0,0,1),0u),c,c+ivec3(0,0,1));
    float zm=limited_flux(face_w(c,0u),c-ivec3(0,0,1),c);
    float updated=own-dt/h*(xp-xm+yp-ym+zp-zm);
    fields[vof_off(1u-pc.flags.x)+ci(c)]=clamp(updated,0.,1.);
#endif
}