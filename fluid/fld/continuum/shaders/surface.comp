#version 450
// Continuous volume-fraction isosurface, not particle impostors.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D scene_depth;
layout(set=0,binding=1) uniform sampler2D scene_hdr;
layout(rgba16f,set=0,binding=2) writeonly uniform image2D final_color;
#if defined(CONT_RENDER)
layout(std430,set=0,binding=3) readonly buffer Grid { float fields[]; };
layout(rgba16f,set=0,binding=6) writeonly uniform image2D liquid_layer;
#else
layout(rgba16f,set=0,binding=6) readonly uniform image2D liquid_layer;
#endif
layout(push_constant) uniform Parameters
{
    mat4 inverse_vp;
    vec4 origin_cell;     // xyz origin, w cell width
    uvec4 grid;           // nx, ny, nz, support layer
    uvec4 screen;         // render dimensions, reverse depth, VOF bank
    vec4 optical_pigment; // thin-layer RGB, optical density coefficient
} pc;

const float far_limit=1e20;
vec3 unproject(vec2 ndc,float d)
{
    vec4 p=pc.inverse_vp*vec4(ndc,d,1.);
    return p.xyz/p.w;
}
bool ray_box(vec3 ro,vec3 rd,vec3 lo,vec3 hi,out float a,out float b)
{
    a=0.;b=far_limit;
    for(int axis=0;axis<3;++axis)
    {
        if(abs(rd[axis])<1e-7)
        {
            if(ro[axis]<lo[axis] || ro[axis]>hi[axis])return false;
        }
        else
        {
            float t0=(lo[axis]-ro[axis])/rd[axis];
            float t1=(hi[axis]-ro[axis])/rd[axis];
            a=max(a,min(t0,t1));b=min(b,max(t0,t1));
        }
    }
    return b>a;
}
#if defined(CONT_RENDER)
uint total(){return pc.grid.x*pc.grid.y*pc.grid.z;}
float fetch_vof(ivec3 c)
{
    if(any(lessThan(c,ivec3(0))) ||
       any(greaterThanEqual(c,ivec3(pc.grid.xyz))))return 0.;
    uint i=(uint(c.z)*pc.grid.y+uint(c.y))*pc.grid.x+uint(c.x);
    return fields[pc.screen.w*total()+i];
}
bool valid_cell(ivec3 c)
{
    return all(greaterThanEqual(c,ivec3(0))) &&
           all(lessThan(c,ivec3(pc.grid.xyz)));
}
bool solid_cell(ivec3 c)
{
    if(!valid_cell(c))return true;
    uint i=(uint(c.z)*pc.grid.y+uint(c.y))*pc.grid.x+uint(c.x);
    return fields[6u*total()+i]>.5;
}
// Bilinear surface reconstruction of the liquid volume fraction in the
// first fluid layer above an actual solid collider. Its equivalent height
// makes sub-cell puddles visible without inventing additional liquid mass.
// Visual-only extrapolation into the first boundary cell of a solid.
// It avoids a dry moat without changing any simulated fluid mass.
float boundary_fill(ivec3 c)
{
    if(!valid_cell(c))return 0.;
    if(!solid_cell(c))return fetch_vof(c);
    float f=0.;
    const ivec3 dirs[6]=ivec3[6](
        ivec3(1,0,0),ivec3(-1,0,0),
        ivec3(0,1,0),ivec3(0,-1,0),
        ivec3(0,0,1),ivec3(0,0,-1));
    for(int i=0;i<6;++i)
    {
        ivec3 n=c+dirs[i];
        if(valid_cell(n) && !solid_cell(n))
            f=max(f,fetch_vof(n));
    }
    return f;
}
float ground_cell_fill(ivec3 c)
{
    if(!valid_cell(c) || !solid_cell(c-ivec3(0,1,0)))return 0.;
    if(!solid_cell(c))return fetch_vof(c);
    float f=0.;
    const ivec3 dirs[4]=ivec3[4](
        ivec3(1,0,0),ivec3(-1,0,0),
        ivec3(0,0,1),ivec3(0,0,-1));
    for(int i=0;i<4;++i)
    {
        ivec3 n=c+dirs[i];
        if(valid_cell(n) && !solid_cell(n))f=max(f,fetch_vof(n));
    }
    return f;
}
float ground_fill(vec2 world_xz)
{
    if(pc.grid.w==0u)return 0.;
    float h=pc.origin_cell.w;
    vec2 g=(world_xz-pc.origin_cell.xz)/h-vec2(.5);
    ivec2 base=ivec2(floor(g));
    vec2 t=fract(g);
    float fill=0.;
    for(int z=0;z<2;++z)
    for(int x=0;x<2;++x)
    {
        ivec3 c=ivec3(base.x+x,int(pc.grid.w),base.y+z);
        float weight=(x==0?1.-t.x:t.x)*(z==0?1.-t.y:t.y);
        fill+=ground_cell_fill(c)*weight;
    }
    return clamp(fill,0.,1.);
}
// Use the connected local ground mass, not a single low-concentration
// cell, to classify a puddle. This suppresses diffuse VOF residue.
vec2 ground_support(vec2 world_xz)
{
    if(pc.grid.w==0u)return vec2(0.);
    vec2 g=(world_xz-pc.origin_cell.xz)/pc.origin_cell.w-vec2(.5);
    ivec2 base=ivec2(floor(g+.5));
    float maximum=0.,sum=0.;
    int count=0;
    for(int z=-1;z<=1;++z)
    for(int x=-1;x<=1;++x)
    {
        ivec3 c=ivec3(base.x+x,int(pc.grid.w),base.y+z);
        if(!valid_cell(c) || solid_cell(c) ||
           !solid_cell(c-ivec3(0,1,0)))continue;
        float f=fetch_vof(c);
        maximum=max(maximum,f);
        sum+=f;
        count++;
    }
    return vec2(maximum,count>0?sum/float(count):0.);
}
float volume(vec3 pos)
{
    vec3 coord=(pos-pc.origin_cell.xyz)/pc.origin_cell.w-vec3(.5);
    ivec3 base=ivec3(floor(coord));
    vec3 t=fract(coord);
    float value=0.;
    for(int z=0;z<2;++z)
    for(int y=0;y<2;++y)
    for(int x=0;x<2;++x)
    {
        vec3 weight=mix(vec3(1.)-t,t,vec3(x,y,z));
        value+=boundary_fill(base+ivec3(x,y,z))*
               weight.x*weight.y*weight.z;
    }
    return value;
}
void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(pixel,ivec2(pc.screen.xy))))return;
    vec2 uv=(vec2(pixel)+.5)/vec2(pc.screen.xy);
    vec2 ndc=uv*2.-1.;
    bool reverse=pc.screen.z!=0u;
    vec3 near_point=unproject(ndc,reverse?.999:.001);
    vec3 far_point=unproject(ndc,reverse?.001:.999);
    vec3 ray=normalize(far_point-near_point);
    float d=texture(scene_depth,uv).r;
    bool background=reverse?d<=.000001:d>=.999999;
    float scene_t=background?far_limit:dot(unproject(ndc,d)-near_point,ray);
    vec3 bounds_min=pc.origin_cell.xyz;
    vec3 bounds_max=bounds_min+vec3(pc.grid.xyz)*pc.origin_cell.w;
    float entry,exit_t;
    if(!ray_box(near_point,ray,bounds_min,bounds_max,entry,exit_t))
    {
        imageStore(liquid_layer,pixel,vec4(0.,0.,0.,-1.));return;
    }
    exit_t=min(exit_t,scene_t);
    float step_size=pc.origin_cell.w*.65;
    float t=entry;
    float previous=t;
    bool hit=false;
    // Bulk water uses the continuous 3D VOF isosurface.
    for(int i=0;i<128;++i)
    {
        if(t>exit_t)break;
        if(volume(near_point+ray*t)>.32)
        {
            hit=true;break;
        }
        previous=t;
        t+=step_size;
    }
    float h=pc.origin_cell.w;
    if(hit)
    {
        float a=previous,b=t;
        for(int i=0;i<4;++i)
        {
            float mid=.5*(a+b);
            if(volume(near_point+ray*mid)>.32)b=mid;
            else a=mid;
        }
        t=.5*(a+b);
    }
    // A puddle thinner than one grid cell has a nonzero VOF but may never
    // cross the .32 bulk isovalue, and a ray may step over it entirely.
    // Intersect its reconstructed height analytically at the actual floor.
    bool film=false;
    float film_height=0.;
    float film_fill=0.;
    float film_core=0.;
    if(pc.grid.w>0u && ray.y<-.00001)
    {
        float support_y=pc.origin_cell.y+float(pc.grid.w)*h;
        float floor_t=(support_y-near_point.y)/ray.y;
        if(floor_t>=entry && floor_t<=exit_t+h/abs(ray.y))
        {
            float f=ground_fill((near_point+ray*floor_t).xz);
            float film_t=floor_t;
            for(int i=0;i<3;++i)
            {
                film_t=(support_y+h*f-near_point.y)/ray.y;
                f=ground_fill((near_point+ray*film_t).xz);
            }
            vec2 support=ground_support((near_point+ray*film_t).xz);
            float core=support.x;
            // A faint numerical wake is not a puddle.
            if(f>.045 && core>.11 && support.y>.05 &&
               film_t>=entry && film_t<exit_t &&
               film_t<=scene_t+.008 && (!hit || film_t<t))
            {
                film=true;
                hit=true;
                t=film_t;
                film_height=h*f;
                film_fill=f;
                film_core=core;
            }
        }
    }
    // The direct top-surface intersection above is ideal for downward
    // rays. At grazing angles the ray can travel through the side of a
    // sub-cell film without ever intersecting its horizontal top plane.
    // Find the first entry into the occupied ground-height field only
    // inside its one-cell vertical slab. This is a local fallback, not
    // a second displaced or independently rendered fluid surface.
    if(pc.grid.w>0u && !film)
    {
        float support_y=pc.origin_cell.y+float(pc.grid.w)*h;
        float slab_start=entry;
        float slab_end=hit?min(t,exit_t):exit_t;
        if(abs(ray.y)>1e-6)
        {
            float lower=(support_y-near_point.y)/ray.y;
            float upper=(support_y+h-near_point.y)/ray.y;
            slab_start=max(slab_start,min(lower,upper));
            slab_end=min(slab_end,max(lower,upper));
        }
        else if(near_point.y<support_y || near_point.y>support_y+h)
            slab_end=slab_start;
        float march_step=h*.40;
        if(slab_start<slab_end)
        {
            for(int i=0;i<128;++i)
            {
                float probe_t=slab_start+float(i)*march_step;
                if(probe_t>=slab_end || probe_t>=scene_t-.003)break;
                vec3 probe=near_point+ray*probe_t;
                float f=ground_fill(probe.xz);
                if(f<=.045 || probe.y<support_y-.001 ||
                   probe.y>support_y+h*f)continue;
                vec2 support=ground_support(probe.xz);
                if(support.x<=.11 || support.y<=.05)continue;
                hit=true;
                film=true;
                t=probe_t;
                film_fill=f;
                film_core=support.x;
                film_height=h*f;
                break;
            }
        }
    }
    if(!hit)
    {
        imageStore(liquid_layer,pixel,vec4(0.,0.,0.,-1.));return;
    }
    vec3 pos=near_point+ray*t;
    vec3 normal;
    float thickness=0.;
    float meniscus=0.;
    if(film)
    {
        float slope_x=(ground_fill(pos.xz+vec2(h,0.))-
                       ground_fill(pos.xz-vec2(h,0.)))*.5;
        float slope_z=(ground_fill(pos.xz+vec2(0.,h))-
                       ground_fill(pos.xz-vec2(0.,h)))*.5;
        normal=normalize(vec3(-slope_x,1.,-slope_z));
        thickness=film_height/max(.15,abs(ray.y));
        // A shallow contact line is most visible through the changing
        // surface normal, not through an artificial colored tint.
        meniscus=smoothstep(.008,.09,length(vec2(slope_x,slope_z)));
    }
    else
    {
        vec3 grad=vec3(
            volume(pos+vec3(h,0,0))-volume(pos-vec3(h,0,0)),
            volume(pos+vec3(0,h,0))-volume(pos-vec3(0,h,0)),
            volume(pos+vec3(0,0,h))-volume(pos-vec3(0,0,h)));
        normal=dot(grad,grad)>1e-7?normalize(-grad):-ray;
        for(int i=0;i<24;++i)
        {
            float point_t=t+(float(i)+.5)*h*.5;
            if(point_t>=exit_t)break;
            float f=volume(near_point+ray*point_t);
            thickness+=h*.5*f;
            if(i>3 && f<.08)break;
        }
    }
    if(dot(normal,ray)>0.)normal=-normal;
    thickness=max(.001,thickness);
    // Water is almost colorless at ordinary viewing thickness. Let the
    // floor/objects behind it and neutral environmental reflections
    // establish its appearance, without a painted blue/green overlay.
    // Approximate screen-space Snell refraction. Resolve the displacement
    // in camera axes and reject offsets across opaque depth discontinuities
    // so nearby cube silhouettes do not acquire transparent fringes.
#if defined(FLD_BLOOD)
    // Blood is the SAME volume and normal field as water, with different
    // rheology and strongly wavelength-selective absorption. These RGB
    // coefficients are artistic approximations, not measured spectra.
    const float ior=1.35;
    vec3 transmitted=refract(ray,normal,1./ior);
    vec3 bend=transmitted-ray;
    vec3 camera_right=normalize(pc.inverse_vp[0].xyz);
    vec3 camera_up=normalize(pc.inverse_vp[1].xyz);
    vec2 shift=vec2(dot(bend,camera_right),-dot(bend,camera_up));
    vec2 sample_uv=clamp(uv+shift*min(.010,thickness*.065),
                         vec2(.001),vec2(.999));
    float sample_depth=texture(scene_depth,sample_uv).r;
    if(abs(sample_depth-d)>.0015)sample_uv=uv;
    vec3 behind=texture(scene_hdr,sample_uv).rgb;

    // A thin layer is luminous crimson and still transmits the floor.
    // Increasing optical thickness makes it opaque and deep burgundy.
    float optical_length=max(0.,thickness);
    float pigment_opacity=1.-exp(-pc.optical_pigment.a*optical_length);
    float darkening=smoothstep(.005,.13,optical_length);
    vec3 shallow=max(pc.optical_pigment.rgb,vec3(0.));
    vec3 deep=shallow*vec3(.16,.11,.22);
    vec3 pigment=mix(shallow,deep,darkening);
    // The remaining transmission attenuates green and blue faster than red.
    vec3 transmitted_color=behind*exp(
        -vec3(4.0,42.0,55.0)*optical_length);
    vec3 color=mix(transmitted_color,pigment,pigment_opacity);

    float fresnel=.024+(1.-.024)*
        pow(1.-clamp(dot(normal,-ray),0.,1.),5.);
    vec3 light=normalize(vec3(.42,.85,.30));
    vec3 half_vector=normalize(light-ray);
    float highlight=pow(max(dot(normal,half_vector),0.),116.);
    color=mix(color,vec3(.42,.33,.31),fresnel*.66)+
          vec3(.35*highlight);

    if(film)
    {
        color+=vec3(.072,.018,.017)*meniscus;
        float presence=smoothstep(.030,.15,film_fill)*
                       smoothstep(.08,.25,film_core);
        color=mix(behind,color,presence);
    }
#else
    vec3 transmitted=refract(ray,normal,1./1.333);
    vec3 bend=transmitted-ray;
    vec3 camera_right=normalize(pc.inverse_vp[0].xyz);
    vec3 camera_up=normalize(pc.inverse_vp[1].xyz);
    vec2 shift=vec2(dot(bend,camera_right),-dot(bend,camera_up));
    vec2 refracted_uv=clamp(
        uv+shift*min(.014,max(0.,thickness)*.12),
        vec2(.001),vec2(.999));
    float refracted_depth=texture(scene_depth,refracted_uv).r;
    if(abs(refracted_depth-d)>.0015)refracted_uv=uv;
    vec3 behind=texture(scene_hdr,refracted_uv).rgb;
    float f0=.0204;
    float fresnel=f0+(1.-f0)*pow(1.-clamp(dot(normal,-ray),0.,1.),5.);
    vec3 absorb=exp(-vec3(.11,.075,.05)*thickness);
    vec3 color=behind*absorb;
    vec3 light=normalize(vec3(.42,.85,.30));
    vec3 half_vector=normalize(light-ray);
    float specular=pow(max(dot(normal,half_vector),0.),128.);
    color=mix(color,vec3(.66),fresnel)+vec3(specular*.55);
    if(film)
    {
        float sheen=.085+.12*clamp(film_fill,0.,1.);
        color=mix(color,vec3(.74),sheen);
        color+=vec3(.12*meniscus);
        float presence=smoothstep(.030,.15,film_fill)*
                       smoothstep(.08,.25,film_core);
        color=mix(behind,color,presence);
    }
#endif
    imageStore(liquid_layer,pixel,vec4(color,t));
}
#else
void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(pixel,ivec2(pc.screen.xy))))return;
    vec2 uv=(vec2(pixel)+.5)/vec2(pc.screen.xy);
    ivec2 low=imageSize(liquid_layer);
    vec2 coord=uv*vec2(low)-vec2(.5);
    ivec2 first=ivec2(floor(coord));
    vec2 weights=fract(coord);
    float d=texelFetch(scene_depth,pixel,0).r;
    bool reverse=pc.screen.z!=0u;
    bool background=reverse?d<=.000001:d>=.999999;
    vec2 ndc=uv*2.-1.;
    float scene_t=far_limit;
    if(!background)
    {
        vec3 near_point=unproject(ndc,reverse?.999:.001);
        vec3 far_point=unproject(ndc,reverse?.001:.999);
        vec3 ray=normalize(far_point-near_point);
        scene_t=dot(unproject(ndc,d)-near_point,ray);
    }
    vec3 opaque_world=background?vec3(0.):unproject(ndc,d);
    vec4 candidates[4];
    vec2 candidate_uv[4];
    float sample_weights[4];
    float anchor_weight=-1.;
    float anchor_depth=0.;
    int candidates_count=0;
    for(int y=0;y<2;++y)
    for(int x=0;x<2;++x)
    {
        ivec2 sample_pos=clamp(first+ivec2(x,y),ivec2(0),low-1);
        vec4 sample_color=imageLoad(liquid_layer,sample_pos);
        if(sample_color.a<0.)continue;
        vec2 sample_uv=(vec2(sample_pos)+.5)/vec2(low);
        ivec2 source_pixel=clamp(
            ivec2(sample_uv*vec2(pc.screen.xy)),
            ivec2(0),ivec2(pc.screen.xy)-1);
        float source_depth=texelFetch(scene_depth,source_pixel,0).r;
        bool source_background=reverse?source_depth<=.000001:
                                       source_depth>=.999999;
        if(source_background!=background)continue;
        if(!background)
        {
            vec2 source_ndc=sample_uv*2.-1.;
            vec3 source_scene=unproject(source_ndc,source_depth);
            vec3 source_near=unproject(source_ndc,reverse?.999:.001);
            vec3 source_far=unproject(source_ndc,reverse?.001:.999);
            vec3 source_ray=normalize(source_far-source_near);
            float source_t=dot(source_scene-source_near,source_ray);
            // Accept a liquid hit only if it is in front of the same
            // opaque surface and both rays land on the same geometric
            // neighborhood. Comparing only radial depth admits samples
            // from an adjacent cube side, producing a double edge.
            if(sample_color.a>source_t+.006)continue;
            if(length(source_scene-opaque_world)>
               max(.11,.012*scene_t))continue;
        }
        float weight=(x==0?1.-weights.x:weights.x)*
                     (y==0?1.-weights.y:weights.y);
        // Preserve the closest surface sheet at the dominant pixel
        // rather than averaging unrelated front/back intersections.
        candidates[candidates_count]=sample_color;
        candidate_uv[candidates_count]=sample_uv;
        sample_weights[candidates_count]=weight;
        if(weight>anchor_weight)
        {
            anchor_weight=weight;
            anchor_depth=sample_color.a;
        }
        ++candidates_count;
    }
    vec3 correction=vec3(0.);
    float coverage=0.;
    for(int i=0;i<candidates_count;++i)
    {
        vec4 sample_color=candidates[i];
        if(abs(sample_color.a-anchor_depth)>
           max(.025,.009*anchor_depth))continue;
        float weight=sample_weights[i];
#if defined(FLD_BLOOD)
        // Do not upscale a second copy of the checkerboard. Composite
        // only the optical change relative to the actual full-resolution
        // scene pixel; otherwise it creates pink ghosts and doubled edges.
        vec3 reference=texture(scene_hdr,candidate_uv[i]).rgb;
        correction+=(sample_color.rgb-reference)*weight;
#else
        correction+=sample_color.rgb*weight;
#endif
        coverage+=weight;
    }
    vec3 scene=texelFetch(scene_hdr,pixel,0).rgb;
#if defined(FLD_BLOOD)
    vec3 out_color=scene+(coverage>1e-5?
        correction/coverage*clamp(coverage,0.,1.):vec3(0.));
#else
    vec3 out_color=coverage>1e-5?
        mix(scene,correction/coverage,clamp(coverage,0.,1.)):scene;
#endif
    imageStore(final_color,pixel,vec4(out_color,1.));
}
#endif
