#version 450
layout(local_size_x=128) in;
layout(std430,set=0,binding=1) readonly buffer Bounds { vec4 spheres[]; };
layout(std430,set=0,binding=2) buffer Visible {uint visible_ids[];};
struct Draw {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};
layout(std430,set=0,binding=3) buffer Draws {Draw draws[];};
// Optional virtual page path. The existing whole-mesh LOD path runs if
// pc.info.z is zero; both modes share exactly one instance/visibility layout.
struct Instance {mat4 model;mat4 normal;vec4 tint;};
layout(std430,set=0,binding=0) readonly buffer Instances {
    Instance instances[];
};
struct Page {vec4 sphere;uvec4 info;};
layout(std430,set=0,binding=10) readonly buffer Pages {
    Page page_meta[];
};
layout(set=1,binding=0) uniform sampler2D hiz_depth;
layout(std140,set=1,binding=1) uniform VisibilityView {
    vec4 planes[6];
    mat4 previous_vp;
    vec4 previous_camera;
    vec4 options; // enabled, viewport width, viewport height, mip count
    vec4 animated_count;
    vec4 animated_rects[64]; // previous/current animated occluder footprints
} visible;
layout(push_constant) uniform Selection {
    vec4 camera;        // position.xyz, pixels per world unit at depth 1
    vec4 error;         // per-level geometric error / mesh radius
    uvec4 info;         // instance count, active levels
    uvec4 indices;      // index counts
} pc;

bool occluded(vec4 sphere)
{
    if(visible.options.x<0.5 || sphere.w<=0.0)return false;
    // Project all eight corners of the bounding box. Its projection contains
    // the sphere, including near-depth and the full screen-space footprint.
    vec2 lo=vec2(1e9),hi=vec2(-1e9);
    float near_depth=1.0;
    for(int z=0;z<2;++z)
    for(int y=0;y<2;++y)
    for(int x=0;x<2;++x) {
        vec3 corner=sphere.xyz+sphere.w*vec3(
            x==0?-1.0:1.0,y==0?-1.0:1.0,z==0?-1.0:1.0);
        vec4 clip=visible.previous_vp*vec4(corner,1.0);
        if(clip.w<=0.0)return false;
        vec3 ndc=clip.xyz/clip.w;
        lo=min(lo,ndc.xy*0.5+0.5);
        hi=max(hi,ndc.xy*0.5+0.5);
        // Raster viewport stores depth in [0.1,1], not raw NDC [0,1].
        near_depth=min(near_depth,ndc.z*0.9+0.1);
    }
    if(any(lessThan(lo,vec2(0.0))) ||
       any(greaterThan(hi,vec2(1.0))) || near_depth<=0.0)
        return false;
    // Leave a conservative pixel margin for subpixel motion and rasterization.
    vec2 pad=2.0/max(visible.options.yz,vec2(1.0));
    lo=max(vec2(0.0),lo-pad);
    hi=min(vec2(0.999999),hi+pad);
    // The depth pyramid includes moving characters. Their old depth cannot
    // occlude static geometry when they move, so reject Hi-Z where either
    // their previous or current conservative screen bounds intersect.
    for(int i=0;i<int(visible.animated_count.x);++i) {
        vec4 occluder_rect=visible.animated_rects[i];
        if(all(greaterThan(hi,occluder_rect.xy)) &&
           all(lessThan(lo,occluder_rect.zw)))return false;
    }
    float footprint=max((hi.x-lo.x)*visible.options.y,
                        (hi.y-lo.y)*visible.options.z);
    float level=clamp(ceil(log2(max(footprint,1.0))),
                      0.0,visible.options.w-1.0);
    int mip=int(level);
    ivec2 dim=textureSize(hiz_depth,mip);
    ivec2 mn=clamp(ivec2(floor(lo*vec2(dim))),ivec2(0),dim-1);
    ivec2 mx=clamp(ivec2(floor(hi*vec2(dim))),ivec2(0),dim-1);
    if(any(greaterThan(mx-mn,ivec2(1))))return false;
    float farthest=0.0;
    for(int y=mn.y;y<=mx.y;++y)
    for(int x=mn.x;x<=mx.x;++x)
        farthest=max(farthest,texelFetch(hiz_depth,ivec2(x,y),mip).r);
    return near_depth>farthest+0.003;
}
void main()
{
    uint id=gl_GlobalInvocationID.x;
    if(id==0u) {
        uint total=pc.info.z!=0u?pc.info.z:(pc.info.y&15u);
        for(uint i=0u;i<total;++i) {
            draws[i].index_count=pc.info.z!=0u?
                page_meta[i].info.y:pc.indices[i];
            draws[i].first_index=0u;
            draws[i].vertex_offset=0;
            draws[i].first_instance=0u;
        }
    }
    if(id>=pc.info.x)return;
    vec4 sphere=spheres[id];
    for(uint i=0u;i<6u;++i)
        if(dot(visible.planes[i],vec4(sphere.xyz,1.0)) < -sphere.w)
            return;
    if((pc.info.y&0x80000000u)==0u && occluded(sphere))return;

    float distance=max(length(sphere.xyz-pc.camera.xyz)-sphere.w,0.1);
    float projected_radius=pc.camera.w*sphere.w/distance;
    uint lod=0u;
    uint levels=pc.info.y&15u;
    for(uint level=1u;level<levels;++level)
        if(projected_radius*pc.error[level]<=1.25)
            lod=level;
    // Whole-level fallback avoids holes when only some cluster pages have
    // arrived. Never select an LOD unless its complete page set is resident.
    uint selected=lod;
    while(selected<levels && (pc.info.w&(1u<<selected))==0u)
        ++selected;
    if(selected>=levels) {
        selected=lod;
        while(selected>0u && (pc.info.w&(1u<<selected))==0u)
            --selected;
    }
    if((pc.info.w&(1u<<selected))==0u)return;
    lod=selected;
    if(pc.info.z!=0u) {
        // Per-page bounds allow independent meshlet visibility while the
        // complete LOD fallback guarantees no missing geometry from paging.
        mat4 model=instances[id].model;
        float r=max(length(model[0].xyz),
                    max(length(model[1].xyz),length(model[2].xyz)));
        for(uint page=0u;page<pc.info.z;++page) {
            Page item=page_meta[page];
            if(item.info.x!=lod || item.info.y==0u)continue;
            vec3 center=(model*vec4(item.sphere.xyz,1.0)).xyz;
            // Virtual cluster pages contain static instances only.
            vec4 bound=vec4(center,item.sphere.w*r*1.05);
            bool page_in_frustum=true;
            for(uint plane=0u;plane<6u;++plane)
                if(dot(visible.planes[plane],vec4(center,1.0))<-bound.w) {
                    page_in_frustum=false;
                    break;
                }
            if(!page_in_frustum || occluded(bound))continue;
            uint out_index=atomicAdd(draws[page].instance_count,1u);
            visible_ids[page*pc.info.x+out_index]=id;
        }
        return;
    }
    uint out_index=atomicAdd(draws[lod].instance_count,1u);
    visible_ids[lod*pc.info.x+out_index]=id;
}
