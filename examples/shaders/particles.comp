#version 450
layout(local_size_x=64) in;
layout(std430,set=0,binding=0) buffer Particles {vec4 position[];};
layout(push_constant) uniform Clock {float seconds;} clock_data;
void main() {
    uint id=gl_GlobalInvocationID.x;
    if(id>=position.length())return;
    vec4 p=position[id];
    float phase=clock_data.seconds*.5+float(id)*.011;
    position[id]=vec4(p.xy+vec2(sin(phase),cos(phase))*.0002,p.z,1);
}
