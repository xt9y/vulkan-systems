#version 450
#extension GL_GOOGLE_include_directive : require
#include "photon_scene.glsl"
// Camera visibility / raw radiance / geometry for temporal validation.
// Direct lighting is read from a view-independent multi-sampled surface cache.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(rgba32f,set=0,binding=8) uniform readonly image2D indirect_atlas;
layout(rgba16f,set=0,binding=0) uniform writeonly image2D noisy_color;
layout(rgba16f,set=0,binding=12) uniform writeonly image2D surface_position;
layout(rgba32f,set=0,binding=19) uniform readonly image2D direct_atlas;
// Compact surface-atlas lookup. The separate compute filter has already
// removed visibility noise and invalid receiver texels. A four-tap
// normalized bilinear sample is enough here, even at Retina resolutions.
layout(std430,set=0,binding=21) readonly buffer DirectMoments {
    vec4 moments[];
};
layout(std430,set=0,binding=22) readonly buffer FilteredDirect {
    vec4 filtered[];
};
vec3 pm_direct_cached(int id,vec3 point,out bool penumbra,
                      out float raw_visibility,out float filtered_visibility,
                      out float variance)
{
    int tile=int(camera.material.z),extent=tile*int(scene_desc.z);
    vec2 uv=clamp(pm_face_uv(id,point)*float(tile)-.5,
                  vec2(0.0),vec2(float(tile)-1.0));
    ivec2 base=ivec2(floor(uv)),origin=ivec2(id%int(scene_desc.z),id/int(scene_desc.z))*tile;
    ivec2 maximum=ivec2(tile-1);
    vec2 t=fract(uv);
    const ivec2 offsets[4]=ivec2[4](
        ivec2(0,0),ivec2(1,0),ivec2(0,1),ivec2(1,1));
    float weights[4]=float[4](
        (1.0-t.x)*(1.0-t.y),t.x*(1.0-t.y),
        (1.0-t.x)*t.y,t.x*t.y);
    vec3 sum=vec3(0.0);
    float filtered_sum=0.0,raw_sum=0.0,weight_sum=0.0;
    float variance_sum=0.0;
    float low=1.0,high=0.0;
    int debug_view=int(camera.material.y+0.5);
    for(int i=0;i<4;++i)
    {
        ivec2 coord=origin+clamp(base+offsets[i],ivec2(0),maximum);
        uint index=uint(coord.x+coord.y*extent);
        vec4 value=filtered[index];
        if(value.a<0.0)continue;
        float w=weights[i];
        sum+=value.rgb*w;
        filtered_sum+=value.a*w;
        low=min(low,value.a);
        high=max(high,value.a);
        if(debug_view==4 || debug_view==6)
        {
            vec4 raw=imageLoad(direct_atlas,coord);
            raw_sum+=raw.a*w;
            if(debug_view==6)
            {
                vec4 stats=moments[index];
                float v=max(stats.y-stats.x*stats.x,0.0);
                variance_sum+=v*w;
            }
        }
        weight_sum+=w;
    }
    if(weight_sum<=1e-6)
    {
        penumbra=true;
        raw_visibility=0.0;
        filtered_visibility=0.0;
        variance=0.0;
        return vec3(0.0);
    }
    filtered_visibility=filtered_sum/weight_sum;
    raw_visibility=raw_sum/weight_sum;
    variance=variance_sum/weight_sum;
    penumbra=(high>0.02 && low<0.98) ||
             (filtered_visibility>0.02 && filtered_visibility<0.98);
    return sum/weight_sum;
}
// Renormalized face-local bilinear sampling: hidden receiver texels
// (alpha=-1 under solid boxes) never darken exposed surfaces.
vec3 pm_lookup(int id,vec3 point)
{
    int tile=int(camera.material.z);
    vec2 uv=clamp(pm_face_uv(id,point)*float(tile)-0.5,
                  vec2(0.0),vec2(float(tile)-1.0));
    ivec2 base=ivec2(floor(uv));
    vec2 t=fract(uv);
    ivec2 offset=ivec2(id%int(scene_desc.z),id/int(scene_desc.z))*tile;
    ivec2 hi=ivec2(tile-1);
    vec4 a=imageLoad(indirect_atlas,offset+clamp(base,ivec2(0),hi));
    vec4 b=imageLoad(indirect_atlas,offset+clamp(base+ivec2(1,0),ivec2(0),hi));
    vec4 c=imageLoad(indirect_atlas,offset+clamp(base+ivec2(0,1),ivec2(0),hi));
    vec4 d=imageLoad(indirect_atlas,offset+clamp(base+ivec2(1,1),ivec2(0),hi));
    vec4 w=vec4((1.0-t.x)*(1.0-t.y),t.x*(1.0-t.y),
                (1.0-t.x)*t.y,t.x*t.y);
    w*=vec4(a.a>=0.0?1.0:0.0,b.a>=0.0?1.0:0.0,
            c.a>=0.0?1.0:0.0,d.a>=0.0?1.0:0.0);
    float weight=w.x+w.y+w.z+w.w;
    return weight>1e-6?
        (a.rgb*w.x+b.rgb*w.y+c.rgb*w.z+d.rgb*w.w)/weight:vec3(0.0);
}
// The cached atlas handles smooth regions. Near shadow boundaries,
// evaluate the actual receiver position with progressive area-light
// samples, avoiding a blurred receiver-space contact silhouette.
// Each screen pixel gets a stable R2 sequence with a pixel scramble;
// temporal history integrates it across frames.
vec3 pm_screen_light(Hit hit,vec3 albedo,uint spp)
{
    Face lamp=faces[scene_desc.y];
    uint pixel=uint(gl_GlobalInvocationID.x)+
               uint(gl_GlobalInvocationID.y)*camera.params.x;
    uint scramble=pixel*747796405u+2891336453u;
    scramble^=scramble>>16u;
    scramble*=2246822519u;
    scramble^=scramble>>13u;
    vec2 offset=vec2(float(scramble&65535u),
                     float((scramble>>16u)&65535u))/65536.0;
    vec3 sum=vec3(0);
    uint first=uint(camera.eye.w)*spp;
    for(uint i=0u;i<spp;++i)
    {
        float sample_index=float(first+i)+0.5;
        vec2 uv=fract(vec2(.7548776662467,.569840290998)*
                      sample_index+offset);
        vec3 source=pm_light_point(uv);
        vec3 delta=source-hit.point;
        float r2=dot(delta,delta);
        if(r2<=1e-6)continue;
        float distance=sqrt(r2);
        vec3 wi=delta/distance;
        float receiver=max(dot(hit.normal,wi),0.0);
        float emitter=max(dot(lamp.normal.xyz,-wi),0.0);
        if(receiver<=0.0 || emitter<=0.0)continue;
        float transmission=pm_shadow_visibility(
            hit.point+hit.normal*PM_EPS,wi,distance-2.0*PM_EPS);
        if(transmission<=0.0)continue;
        sum+=albedo*lamp.emission.rgb*(lamp.metric.w/PM_PI)*
             (receiver*emitter*transmission/r2);
    }
    return sum/float(spp);
}
void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    ivec2 size=ivec2(camera.params.xy);
    if(any(greaterThanEqual(pixel,size)))return;
    uint seed=(uint(pixel.x)+1u)*1973u ^
              (uint(pixel.y)+1u)*9277u ^
              (uint(camera.eye.w)+1u)*26699u ^ 0x9e3779b9u;
    pm_random_bits(seed);
    // Shared Halton(2,3) phase gives stable 16-frame subpixel coverage
    // instead of independent noise-shaped pixel jitter at geometry edges.
    vec2 uv=(vec2(pixel)+pm_taa_jitter(uint(camera.eye.w)))/
             vec2(size)*2.0-1.0;
    uv.y=-uv.y;
    float FOV=max(camera.up.w,0.001);
    vec3 forward=cross(camera.up.xyz,camera.right.xyz);
    vec3 rd=normalize(forward+camera.right.xyz*uv.x*FOV*
                       (float(size.x)/float(size.y))+
                       camera.up.xyz*uv.y*FOV);
    vec3 ro=camera.eye.xyz;
    Hit first;
    bool found=pm_closest(ro,rd,1e20,first);
    if(found)
    {
        imageStore(surface_position,pixel,
                   vec4(first.point,float(first.index+1)));
    }
    else
    {
        imageStore(surface_position,pixel,vec4(0));
    }
    vec3 radiance=vec3(0);
    // Up to six specular interactions, with stationary-world reprojection
    // anchored to the first hit instead of the last refracted surface.
    for(int bounce=0;found && bounce<6;++bounce)
    {
        Hit hit=first;
        if(hit.index==int(scene_desc.x))
        {
            rd=pm_dielectric(rd,hit,seed);
            ro=hit.point+rd*PM_EPS;
            found=pm_closest(ro,rd,1e20,first);
            continue;
        }
        Face surface=faces[hit.index];
        if(surface.emission.w>1.0 || surface.emission.w<0.0) {
            bool reflected=false;
            rd=surface.emission.w>1.0 ?
                pm_surface_dielectric(rd,hit,surface,seed,reflected) :
                pm_surface_conductor(rd,hit,surface,seed);
            ro=hit.point+rd*PM_EPS;
            found=pm_closest(ro,rd,1e20,first);
            continue;
        }
        if(any(greaterThan(surface.emission.rgb,vec3(0))))
            radiance=surface.emission.rgb;
        else
        {
            vec3 indirect=pm_lookup(hit.index,hit.point);
            int debug_view=int(camera.material.y+0.5);
            bool penumbra=false;
            float raw_visibility=0.0,filtered_visibility=0.0,variance=0.0;
            vec3 direct=vec3(0.0);
            // In quality mode all visible receivers use accurate area-light
            // visibility at their actual world-space positions. This removes
            // the surface-atlas resolution and interpolation bias entirely
            // from the direct shadows; photon mapping still supplies GI.
            if(camera.settings.z>0.5 && debug_view<3)
            {
                if(debug_view!=2)
                    direct=pm_screen_light(hit,surface.albedo.rgb,
                                           uint(camera.settings.z));
            }
            else
            {
                direct=pm_direct_cached(hit.index,hit.point,penumbra,
                                        raw_visibility,filtered_visibility,
                                        variance);
                if(penumbra && camera.settings.z<-0.5)
                    direct=pm_screen_light(hit,surface.albedo.rgb,
                                           uint(-camera.settings.z));
            }
            if(debug_view==1)radiance=direct;
            else if(debug_view==2)radiance=indirect;
            else if(debug_view==3)radiance=penumbra?vec3(1.0):vec3(0.0);
            else if(debug_view==4)radiance=vec3(raw_visibility);
            else if(debug_view==5)radiance=vec3(filtered_visibility);
            else if(debug_view==6)radiance=vec3(min(variance*8.0,1.0));
            else radiance=indirect+direct;
        }
        break;
    }
    imageStore(noisy_color,pixel,vec4(max(radiance,vec3(0)),1));
}
