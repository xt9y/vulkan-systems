#version 450
// Reset compact-grid counts and the raw-photon allocation counter.
layout(local_size_x=128,local_size_y=1,local_size_z=1) in;
layout(std430,set=0,binding=3) buffer Counts { uint counts[]; };
layout(std430,set=0,binding=4) buffer Counter { uint used; };
void main()
{
    uint i=gl_GlobalInvocationID.x;
    if(i<4096u)counts[i]=0u;
    if(i==0u)used=0u;
}
