#version 450
#extension GL_GOOGLE_include_directive : require
#include "photon_scene.glsl"
// Accumulate unfiltered direct + photon GI in persistent history. The
// spatial denoiser writes a separate display image, never this history.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(rgba16f,set=0,binding=0) uniform image2D accumulated;
layout(rgba16f,set=0,binding=12) uniform readonly image2D position_now;
layout(rgba16f,set=0,binding=14) uniform readonly image2D position_old;
layout(rgba16f,set=0,binding=16) uniform readonly image2D history_old;
layout(rgba16f,set=0,binding=17) uniform writeonly image2D temporal;
float luminance(vec3 x) {return dot(x,vec3(0.2126,0.7152,0.0722));}
vec3 surface_normal(vec4 surface)
{
    int id=int(surface.w+0.5)-1;
    if(id<0)return vec3(0);
    if(id<int(scene_desc.x))return faces[id].normal.xyz;
    return normalize(surface.xyz-camera.sphere.xyz);
}
bool previous_pixel(vec3 point,ivec2 size,out vec2 pixel)
{
    vec3 delta=point-prev_eye.xyz;
    vec3 forward=cross(prev_up.xyz,prev_right.xyz);
    float z=dot(delta,forward);
    if(z<PM_EPS)return false;
    float FOV=max(prev_up.w,0.001);
    float x=dot(delta,prev_right.xyz)/
             (z*FOV*float(size.x)/float(size.y));
    float y=dot(delta,prev_up.xyz)/(z*FOV);
    pixel=(vec2(x,-y)*0.5+0.5)*vec2(size)-
          pm_taa_jitter(uint(prev_eye.w));
    return all(greaterThan(pixel,vec2(-1))) &&
           all(lessThan(pixel,vec2(size)));
}
void main()
{
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    ivec2 size=imageSize(accumulated);
    if(any(greaterThanEqual(p,size)))return;
    vec3 current=imageLoad(accumulated,p).rgb;
    vec4 here=imageLoad(position_now,p);
    vec3 color=current;
    float variance=0.002;
    bool moving=camera.settings.w>0.5;
    if(camera.settings.y>0.5)
    {
        if(!moving)
        {
            // Same pixel, different Halton subpixel position. Retain
            // mixed-surface coverage at lamp and object silhouettes.
            // No reprojection or geometry rejection in a static view.
            vec4 prior=imageLoad(history_old,p);
            float alpha=1.0/float(min(camera.params.z,512u)+1u);
            color=mix(prior.rgb,current,alpha);
            float error=luminance(current)-luminance(prior.rgb);
            variance=max(0.00001,mix(prior.a,error*error,alpha));
        }
        else if(here.w>0.5)
        {
            vec2 projected;
            if(previous_pixel(here.xyz,size,projected))
            {
                ivec2 base=ivec2(floor(projected));
                vec2 phase=fract(projected);
                vec3 history_sum=vec3(0);
                float variance_sum=0.0,weight_sum=0.0;
                float depth=length(here.xyz-camera.eye.xyz);
                float footprint=2.0*max(camera.up.w,0.001)*
                                max(depth,0.1)/float(size.y);
                float tolerance=max(0.006,1.5*footprint);
                vec3 normal=surface_normal(here);
                for(int dy=0;dy<2;++dy)
                for(int dx=0;dx<2;++dx)
                {
                    ivec2 q=base+ivec2(dx,dy);
                    if(any(lessThan(q,ivec2(0))) ||
                       any(greaterThanEqual(q,size)))continue;
                    vec4 previous_hit=imageLoad(position_old,q);
                    if(abs(previous_hit.w-here.w)>0.25 ||
                       distance(previous_hit.xyz,here.xyz)>tolerance ||
                       dot(surface_normal(previous_hit),normal)<0.85)
                        continue;
                    float w=(dx==0?1.0-phase.x:phase.x)*
                            (dy==0?1.0-phase.y:phase.y);
                    vec4 previous_color=imageLoad(history_old,q);
                    history_sum+=previous_color.rgb*w;
                    variance_sum+=previous_color.a*w;
                    weight_sum+=w;
                }
                if(weight_sum>0.1)
                {
                    vec3 previous_color=history_sum/weight_sum;
                    float alpha=here.w>float(scene_desc.x)?0.22:0.16;
                    color=mix(previous_color,current,alpha);
                    float error=luminance(current)-luminance(previous_color);
                    variance=max(0.00001,mix(variance_sum/weight_sum,
                                              error*error,alpha));
                }
            }
        }
    }
    // The display-only denoiser reads temporal, while the next frame
    // reprojects accumulated (unfiltered) radiance from binding 16.
    vec4 result=vec4(color,variance);
    imageStore(accumulated,p,result);
    imageStore(temporal,p,result);
}
