#version 450
// History reprojection with per-sample surface/depth validation.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(rgba16f,set=0,binding=4) uniform readonly image2D noisy;
layout(rgba16f,set=0,binding=2) uniform readonly image2D position_now;
layout(rgba16f,set=0,binding=3) uniform readonly image2D position_old;
layout(rgba32f,set=0,binding=5) uniform readonly image2D history_old;
layout(rgba16f,set=0,binding=6) uniform writeonly image2D temporal;
layout(std430,set=0,binding=7) readonly buffer PreviousCamera {
    vec4 prev_eye,prev_right,prev_up;
};
struct Face {vec4 origin,u,v,normal,albedo,emission,metric;};
layout(std430,set=0,binding=1) readonly buffer Scene {Face faces[];};
layout(push_constant) uniform Camera {
    vec4 eye,right,up; // up.w contains tan(vertical_fov/2)
    uvec4 params;      // x,y: extent, z: accumulation count, w: bounces
    vec4 settings;     // reuse history, moving, light spp, filter radius
    uvec4 scene;       // surface count, emitter index
} camera;
// The camera projection and previous projection are runtime-configurable.
vec2 jitter(uint frame)
{
    const vec2 samples[16]=vec2[16](
        vec2(.5,.333333333),vec2(.25,.666666667),
        vec2(.75,.111111111),vec2(.125,.444444444),
        vec2(.625,.777777778),vec2(.375,.222222222),
        vec2(.875,.555555556),vec2(.0625,.888888889),
        vec2(.5625,.037037037),vec2(.3125,.370370370),
        vec2(.8125,.703703704),vec2(.1875,.148148148),
        vec2(.6875,.481481481),vec2(.4375,.814814815),
        vec2(.9375,.259259259),vec2(.03125,.592592593));
    return samples[frame&15u];
}
float luminance(vec3 c){return dot(c,vec3(.2126,.7152,.0722));}
bool reproject(vec3 world,ivec2 size,out vec2 projected)
{
    vec3 delta=world-prev_eye.xyz;
    vec3 forward=cross(prev_up.xyz,prev_right.xyz);
    float z=dot(delta,forward);
    if(z<=.001)return false;
    float half_fov=max(prev_up.w,0.001);
    vec2 xy=vec2(dot(delta,prev_right.xyz)/
                     (z*half_fov*float(size.x)/float(size.y)),
                 -dot(delta,prev_up.xyz)/(z*half_fov));
    projected=(xy*.5+.5)*vec2(size)-jitter(uint(prev_eye.w));
    return all(greaterThan(projected,vec2(-1))) &&
           all(lessThan(projected,vec2(size)));
}
void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    ivec2 size=imageSize(noisy);
    if(any(greaterThanEqual(pixel,size)))return;
    vec3 current=imageLoad(noisy,pixel).rgb;
    vec4 here=imageLoad(position_now,pixel);
    vec3 color=current;
    float variance=.002;
    vec2 previous=vec2(pixel);
    bool moving=camera.settings.y>.5;
    // Stationary paths estimate the pixel integral across jittered rays.
    // Surface IDs must NOT reject samples at light/silhouette boundaries.
    // After camera motion, however, history must pass world-space and
    // material validation before it can be reused.
    bool valid_projection=!moving ||
        (here.w>.5 && reproject(here.xyz,size,previous));
    if(camera.settings.x>.5 && valid_projection)
    {
        ivec2 base=ivec2(floor(previous));
        vec2 weight=fract(previous);
        vec3 sum=vec3(0);
        float variance_sum=0,weight_sum=0;
        float tolerance=.009;
        if(moving)
        {
            float depth=length(here.xyz-prev_eye.xyz);
            float footprint=2.0*max(prev_up.w,0.001)*max(depth,.1)/float(size.y);
            vec3 n=faces[int(here.w)-1].normal.xyz;
            float grazing=max(abs(dot(n,cross(prev_up.xyz,prev_right.xyz))),.25);
            tolerance=max(tolerance,2.0*footprint/grazing);
        }
        for(int y=0;y<2;++y)
        for(int x=0;x<2;++x)
        {
            ivec2 q=base+ivec2(x,y);
            if(any(lessThan(q,ivec2(0))) ||
               any(greaterThanEqual(q,size)))continue;
            vec4 prior=imageLoad(position_old,q);
            if(moving && (prior.w!=here.w ||
               distance(prior.xyz,here.xyz)>tolerance))continue;
            float w=(x==0?1.0-weight.x:weight.x)*
                    (y==0?1.0-weight.y:weight.y);
            vec4 history=imageLoad(history_old,q);
            sum+=history.rgb*w;
            variance_sum+=history.a*w;
            weight_sum+=w;
        }
        if(weight_sum>.15)
        {
            vec3 history=sum/weight_sum;
            float old_var=max(variance_sum/weight_sum,0.0);
            // Stationary pixels retain the actual progressive mean. Moving
            // pixels use an EMA with geometric validation, never feeding
            // spatially denoised display values back into the history.
            float alpha=moving?.08:
                1.0/float(min(camera.params.z,1000000u)+1u);
            float delta=luminance(current)-luminance(history);
            color=mix(history,current,alpha);
            if(moving)
                variance=max(.0,(1.0-alpha)*(old_var+alpha*delta*delta));
            else
            {
                float count=float(camera.params.z+1u);
                // Online sample variance (Welford), not variance of the
                // accumulated mean. The filter divides by sample count.
                variance=count>1.0?
                    max(0.0,(old_var*max(count-2.0,0.0)+
                         delta*(delta*(1.0-alpha)))/max(count-1.0,1.0)):0.0;
            }
        }
    }
    imageStore(temporal,pixel,vec4(color,variance));
}
