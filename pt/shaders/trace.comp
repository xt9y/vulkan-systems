#version 450
// Software path tracing, progressive reconstruction, one pixel per invocation.
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(rgba16f,set=0,binding=4) uniform writeonly image2D noisy_radiance;
layout(rgba16f,set=0,binding=2) uniform writeonly image2D hit_position;
struct Face {vec4 origin,u,v,normal,albedo,emission,metric;};
layout(std430,set=0,binding=1) readonly buffer Scene {Face faces[];};
layout(push_constant) uniform Camera {
    vec4 eye,right,up; // up.w contains tan(vertical_fov/2)
    uvec4 params;      // x,y: extent, z: accumulation count, w: bounces
    vec4 settings;     // reuse history, moving, light spp, filter radius
    uvec4 scene;       // surface count, emitter index
} camera;
const float PI=3.14159265358979323846;
const float EPSILON=.0008;
const float SHADOW_EPSILON=.00001;
// Surface count and selected area emitter are supplied by the host.
struct Hit {float t;int index;vec3 point,normal;};

uint random_bits(inout uint state)
{
    state^=state<<13;
    state^=state>>17;
    state^=state<<5;
    return state;
}
uint hash(uint x)
{
    x^=x>>16;x*=0x7feb352du;
    x^=x>>15;x*=0x846ca68bu;
    return x^(x>>16);
}
float random01(inout uint state)
{
    return float(random_bits(state)>>8)*(1.0/16777216.0);
}
vec2 jitter(uint frame)
{
    const vec2 samples[16]=vec2[16](
        vec2(.5,.333333333),vec2(.25,.666666667),
        vec2(.75,.111111111),vec2(.125,.444444444),
        vec2(.625,.777777778),vec2(.375,.222222222),
        vec2(.875,.555555556),vec2(.0625,.888888889),
        vec2(.5625,.037037037),vec2(.3125,.370370370),
        vec2(.8125,.703703704),vec2(.1875,.148148148),
        vec2(.6875,.481481481),vec2(.4375,.814814815),
        vec2(.9375,.259259259),vec2(.03125,.592592593));
    return samples[frame&15u];
}
bool intersect_face(vec3 ro,vec3 rd,Face face,float limit,
                    float minimum,out float distance)
{
    float denominator=dot(face.normal.xyz,rd);
    if(denominator>=-1e-6)return false;
    float t=dot(face.origin.xyz-ro,face.normal.xyz)/denominator;
    if(t<=minimum || t>=limit)return false;
    vec3 d=ro+rd*t-face.origin.xyz;
    vec2 q=vec2(dot(d,face.u.xyz),dot(d,face.v.xyz));
    float x=q.x*face.metric.x+q.y*face.metric.y;
    float y=q.x*face.metric.y+q.y*face.metric.z;
    if(x<0.0 || x>1.0 || y<0.0 || y>1.0 ||
       (face.normal.w>0.5 && x+y>1.0))return false;
    distance=t;
    return true;
}
bool closest_hit(vec3 ro,vec3 rd,float limit,out Hit hit)
{
    hit.t=limit;hit.index=-1;
    for(uint i=0u;i<camera.scene.x;++i)
    {
        float t;
        if(intersect_face(ro,rd,faces[i],hit.t,EPSILON,t))
        {hit.t=t;hit.index=int(i);}
    }
    if(hit.index<0)return false;
    hit.point=ro+rd*hit.t;
    hit.normal=faces[hit.index].normal.xyz;
    return true;
}
bool blocked(vec3 ro,vec3 rd,float limit)
{
    for(uint i=0u;i<camera.scene.x;++i)
    {
        float t;
        if(intersect_face(ro,rd,faces[i],limit,SHADOW_EPSILON,t))
            return true;
    }
    return false;
}
vec3 cosine_hemisphere(vec3 normal,inout uint seed)
{
    float r=sqrt(random01(seed));
    float phi=2.0*PI*random01(seed);
    vec3 axis=abs(normal.z)<.99?vec3(0,0,1):vec3(0,1,0);
    vec3 tangent=normalize(cross(axis,normal));
    vec3 bitangent=cross(normal,tangent);
    return tangent*(r*cos(phi))+bitangent*(r*sin(phi))+
           normal*sqrt(max(0.0,1.0-r*r));
}
vec2 light_sequence(uint bounce,uint sample_index)
{
    // Low-discrepancy R2 area-light samples with per-pixel CP rotation.
    // Unlike repeatedly randomized 4x4 strata, this converges smoothly.
    uint pixel=gl_GlobalInvocationID.x+
               gl_GlobalInvocationID.y*camera.params.x;
    uint h=hash(pixel^(bounce*0x9e3779b9u));
    vec2 rotation=vec2(float(h&65535u),
                       float((h>>16u)&65535u))/65536.0;
    uint spp=uint(camera.settings.z);
    float n=float(uint(camera.eye.w)*max(spp,1u)+
                  sample_index+bounce*131u)+.5;
    return fract(vec2(.7548776662467,.569840290998)*n+rotation);
}
vec3 sample_light(Hit hit,vec3 albedo,uint bounce,uint sample_index)
{
    Face lamp=faces[camera.scene.y];
    vec2 uv=light_sequence(bounce,sample_index);
    if(lamp.normal.w>0.5)
    {
        float root=sqrt(uv.x);
        uv=vec2(1.0-root,root*uv.y);
    }
    vec3 position=lamp.origin.xyz+lamp.u.xyz*uv.x+lamp.v.xyz*uv.y;
    vec3 offset=position-hit.point;
    float r2=dot(offset,offset);
    if(r2<=1e-8)return vec3(0);
    float distance=sqrt(r2);
    vec3 wi=offset/distance;
    float receiver=max(dot(hit.normal,wi),0.0);
    float emitter=max(dot(lamp.normal.xyz,-wi),0.0);
    if(receiver<=0.0 || emitter<=0.0)return vec3(0);
    if(blocked(hit.point+hit.normal*EPSILON,wi,
               distance-2.0*EPSILON))return vec3(0);
    return albedo*lamp.emission.rgb*
           ((lamp.metric.w/PI)*(receiver*emitter/r2));
}
vec3 trace_path(vec3 origin,vec3 direction,inout uint seed,
                out vec4 first_hit)
{
    vec3 throughput=vec3(1),radiance=vec3(0);
    first_hit=vec4(0);
    uint limit=clamp(camera.params.w,1u,8u);
    for(uint bounce=0u;bounce<limit;++bounce)
    {
        Hit hit;
        if(!closest_hit(origin,direction,1e20,hit))break;
        if(bounce==0u)
            first_hit=vec4(hit.point,float(hit.index+1));
        Face face=faces[hit.index];
        if(any(greaterThan(face.emission.rgb,vec3(0))))
        {
            // Explicit NEE handles secondary emitter paths.
            if(bounce==0u)radiance+=throughput*face.emission.rgb;
            break;
        }
        const uint samples=bounce==0u?
            uint(max(camera.settings.z,1.0)):1u;
        vec3 direct=vec3(0);
        for(uint i=0u;i<samples;++i)
            direct+=sample_light(hit,face.albedo.rgb,bounce,i);
        radiance+=throughput*direct/float(samples);
        throughput*=face.albedo.rgb;
        if(bounce+1u==limit)break;
        if(bounce>=3u)
        {
            float survival=clamp(max(max(throughput.x,throughput.y),
                                      throughput.z),.05,.95);
            if(random01(seed)>survival)break;
            throughput/=survival;
        }
        direction=cosine_hemisphere(hit.normal,seed);
        origin=hit.point+hit.normal*EPSILON;
    }
    return max(radiance,vec3(0));
}
void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    ivec2 size=ivec2(camera.params.xy);
    if(any(greaterThanEqual(pixel,size)))return;
    uint frame=uint(camera.eye.w);
    uint seed=hash((uint(pixel.x)+1u)*1973u ^
                   (uint(pixel.y)+1u)*9277u ^
                   (frame+1u)*26699u ^ 0x9e3779b9u);
    vec2 uv=(vec2(pixel)+jitter(frame))/vec2(size)*2.0-1.0;
    uv.y=-uv.y;
    float TAN_HALF_FOV=max(camera.up.w,0.001);
    vec3 forward=cross(camera.up.xyz,camera.right.xyz);
    vec3 ray=normalize(forward+
        camera.right.xyz*uv.x*TAN_HALF_FOV*float(size.x)/float(size.y)+
        camera.up.xyz*uv.y*TAN_HALF_FOV);
    vec4 surface;
    vec3 sample_color=trace_path(camera.eye.xyz,ray,seed,surface);
    imageStore(noisy_radiance,pixel,vec4(sample_color,1.0));
    imageStore(hit_position,pixel,surface);
}
