#version 450
layout(local_size_x=128) in;

struct Patch {
    vec4 position_area;
    vec4 normal;
    vec4 albedo;
    vec4 emission;
};
struct Blocker {
    vec4 minimum;
    vec4 maximum;
};

layout(std430,binding=0) readonly buffer PatchBuffer { Patch patches[]; };
layout(std430,binding=1) buffer ExchangeBuffer { float exchange[]; };
layout(std430,binding=2) buffer InputBuffer { vec4 input_radiance[]; };
layout(std430,binding=3) writeonly buffer OutputBuffer { vec4 output_radiance[]; };
layout(std430,binding=4) readonly buffer BlockerBuffer { Blocker blockers[]; };
layout(std430,binding=5) readonly buffer DeltaInput { vec4 delta_input[]; };
layout(std430,binding=6) writeonly buffer DeltaOutput { vec4 delta_output[]; };
layout(std430,binding=7) buffer EmissionHistory { vec4 old_emission[]; };
struct OrientedBlocker {
    vec4 center;
    vec4 half_extent;
    vec4 axis_x;
    vec4 axis_y;
    vec4 axis_z;
};
layout(std430,binding=8) readonly buffer OrientedBlockerBuffer {
    OrientedBlocker oriented_blockers[];
};
layout(push_constant) uniform Parameters {
    uint count;
    uint blocker_count;
    uint oriented_count;
    uint unused1;
} args;

#ifdef TRANSPORT_BUILD
bool intersects_box(vec3 origin,vec3 direction,vec3 minimum,vec3 maximum)
{
    float near_t=0.0001;
    float far_t=0.9999;
    for(int axis=0;axis<3;++axis)
    {
        if(abs(direction[axis])<0.0000001)
        {
            if(origin[axis]<minimum[axis] || origin[axis]>maximum[axis])
                return false;
        }
        else
        {
            float a=(minimum[axis]-origin[axis])/direction[axis];
            float b=(maximum[axis]-origin[axis])/direction[axis];
            near_t=max(near_t,min(a,b));
            far_t=min(far_t,max(a,b));
            if(far_t<near_t)return false;
        }
    }
    return far_t>=near_t;
}

bool intersects_oriented(vec3 origin,vec3 vector,OrientedBlocker box)
{
    vec3 relative=origin-box.center.xyz;
    vec3 start=vec3(dot(relative,box.axis_x.xyz),
                    dot(relative,box.axis_y.xyz),
                    dot(relative,box.axis_z.xyz));
    vec3 ray=vec3(dot(vector,box.axis_x.xyz),
                  dot(vector,box.axis_y.xyz),
                  dot(vector,box.axis_z.xyz));
    return intersects_box(start,ray,-box.half_extent.xyz,box.half_extent.xyz);
}

void main()
{
    uint index=gl_GlobalInvocationID.x;
    uint total=args.count*args.count;
    if(index>=total)return;
    uint receiver=index/args.count;
    uint sender=index%args.count;
    if(receiver==sender){exchange[index]=0.0;return;}

    Patch a=patches[receiver];
    Patch b=patches[sender];
    vec3 start=a.position_area.xyz+normalize(a.normal.xyz)*0.005;
    vec3 end=b.position_area.xyz+normalize(b.normal.xyz)*0.005;
    vec3 v=end-start;
    float r2=dot(v,v);
    if(r2<0.000001){exchange[index]=0.0;return;}
    float invr=inversesqrt(r2);
    float ca=max(dot(normalize(a.normal.xyz),v)*invr,0.0);
    float cb=max(dot(normalize(b.normal.xyz),-v)*invr,0.0);
    if(ca*cb<=0.0){exchange[index]=0.0;return;}
    for(uint k=0;k<args.blocker_count;k++)
    {
        if(intersects_box(start,v,blockers[k].minimum.xyz,blockers[k].maximum.xyz))
        {
            exchange[index]=0.0;
            return;
        }
    }
    for(uint k=0;k<args.oriented_count;k++)
    {
        if(intersects_oriented(start,v,oriented_blockers[k]))
        {
            exchange[index]=0.0;
            return;
        }
    }
    // Differential form-factor approximation, not an exact finite patch integral.
    exchange[index]=min(ca*cb*b.position_area.w /
                        (3.14159265359*max(r2,b.position_area.w/3.14159265359)),1.0);
}
#elif defined(TRANSPORT_INJECT)
void main()
{
    uint i=gl_GlobalInvocationID.x;
    if(i>=args.count)return;
    vec4 delta=patches[i].emission-old_emission[i];
    delta_output[i]=delta;
    input_radiance[i]+=delta;
    old_emission[i]=patches[i].emission;
}
#elif defined(TRANSPORT_PROPAGATE)
void main()
{
    uint i=gl_GlobalInvocationID.x;
    if(i>=args.count)return;
    vec3 indirect=vec3(0);
    float sum=0.0;
    uint offset=i*args.count;
    for(uint j=0;j<args.count;j++)
    {
        float weight=exchange[offset+j];
        vec3 delta=delta_input[j].rgb;
        if(weight==0.0 || all(lessThan(abs(delta),vec3(0.0000001))))
        {
            sum+=weight;
            continue;
        }
        indirect+=weight*delta;
        sum+=weight;
    }
    vec3 bounce=patches[i].albedo.rgb*(indirect/max(1.0,sum));
    delta_output[i]=vec4(bounce,0.0);
    input_radiance[i].rgb+=bounce;
}
#else
void main()
{
    uint i=gl_GlobalInvocationID.x;
    if(i>=args.count)return;
    vec3 incoming=vec3(0);
    float sum=0.0;
    uint offset=i*args.count;
    for(uint j=0;j<args.count;j++)
    {
        float w=exchange[offset+j];
        incoming+=w*input_radiance[j].rgb;
        sum+=w;
    }
    // Make excessive discrete row sums non-amplifying.
    incoming/=max(1.0,sum);
    vec3 value=patches[i].emission.rgb+patches[i].albedo.rgb*incoming;
    output_radiance[i]=vec4(value,1.0);
}
#endif
